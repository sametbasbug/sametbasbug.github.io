---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppShell from '../components/AppShell.astro';
import Login from '../components/Login.astro';

const FORM_URL = import.meta.env.PUBLIC_CONTACT_FORM_URL || '';
const navItems = [
  { href: '/', label: 'Ana Sayfa' },
  { href: '/bulten', label: 'Bülten' },
  { href: '/etiketler', label: 'Etiketler' },
  { href: '/yazarlar', label: 'Yazarlar' },
  { href: '/hakkimda', label: 'Hakkımda' },
  { href: '/iletisim', label: 'İletişim', active: true },
];
---

<BaseLayout shellLayout={true} title="İletişim" description="Samet Başbuğ ile iletişime geçmek için mesaj formu.">
  <AppShell pageTitle="İletişim" topbarTitle="İletişim" topbarMeta="Mesaj bırak" navItems={navItems} showLoginSlot={true}>
    <Fragment slot="left-login"><Login /></Fragment>
    <Fragment slot="mobile-login"><Login /></Fragment>

    <section class="contact-hero">
      <p class="contact-eyebrow">AÇIK HAT</p>
      <h2>Bir mesaj bırak, bu laboratuvarla temasa geç.</h2>
      <p>Görüş, soru, öneri ya da iş birliği fikri fark etmez. Kısa bir mesaj bırakman yeterli.</p>
    </section>

    <section class="contact-form-shell">
      <form id="contactForm" class="contact-form" novalidate>
        <label>Ad Soyad<input type="text" name="name" placeholder="Ad Soyad" required minlength="2" maxlength="80" /></label>
        <label>E-posta<input type="email" name="email" placeholder="ornek@mail.com" required maxlength="120" /></label>
        <label>Mesaj<textarea name="message" rows="7" placeholder="Mesajını yazabilirsin..." required minlength="30" maxlength="500"></textarea></label>
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="honeypot" />
        <input type="hidden" name="ts" id="ts" />
        <input type="hidden" name="clientId" id="clientId" />
        <div class="form-footer">
          <button type="submit" id="submitBtn">Gönder</button>
          <p id="formStatus" class="status" aria-live="polite"></p>
        </div>
      </form>
    </section>

    <Fragment slot="right-rail">
      <div class="search-box contact-panel">
        <p>İletişim Notu</p>
        <strong class="contact-panel-title">Kısa, net, doğrudan</strong>
        <span>Mesajın 30–500 karakter arasında olmalı.</span>
      </div>
      <section class="who-box">
        <h2 class="panel-title">Ne yazabilirsin?</h2>
        <ul class="who-list">
          <li><span>Geri bildirim</span></li>
          <li><span>İş birliği önerisi</span></li>
          <li><span>Hata bildirimi</span></li>
          <li><span>Merak ettiğin bir detay</span></li>
        </ul>
      </section>
      <section>
        <h2 class="panel-title">Sistem Durumu</h2>
        <ul class="trend-list contact-notes">
          <li><span>Form servisi yapılandırılmışsa mesaj doğrudan iletilir.</span></li>
          <li><span>Spam koruması için gizli alan ve istemci kimliği kullanılır.</span></li>
          <li><span>Gönderim sonrası durum mesajı form altında görünür.</span></li>
        </ul>
      </section>
    </Fragment>
  </AppShell>

  <script is:inline define:vars={{ FORM_URL }}>
    const form = document.getElementById("contactForm");
    const statusEl = document.getElementById("formStatus");
    const submitBtn = document.getElementById("submitBtn");
    const tsInput = document.getElementById("ts");
    const clientIdInput = document.getElementById("clientId");
    if (tsInput) tsInput.value = Date.now();
    const getOrCreateClientId = () => {
      try {
        const key = "contact_client_id";
        let id = localStorage.getItem(key);
        if (!id) {
          id = (crypto?.randomUUID?.() || `${Date.now()}-${Math.random().toString(16).slice(2)}`);
          localStorage.setItem(key, id);
        }
        return id;
      } catch {
        return `fallback-${Date.now()}-${Math.random().toString(16).slice(2)}`;
      }
    };
    if (clientIdInput) clientIdInput.value = getOrCreateClientId();
    const setStatus = (message, isError = false) => {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.dataset.state = isError ? "error" : "ok";
    };
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!FORM_URL) { setStatus("Form servisi henüz yapılandırılmadı (PUBLIC_CONTACT_FORM_URL eksik).", true); return; }
      const fd = new FormData(form); const payload = Object.fromEntries(fd.entries());
      if (!payload.name || !payload.email || !payload.message) { setStatus("Lütfen tüm zorunlu alanları doldur.", true); return; }
      const messageLength = String(payload.message).trim().length;
      if (messageLength < 30 || messageLength > 500) { setStatus("Mesaj 30 ile 500 karakter arasında olmalı.", true); return; }
      submitBtn?.setAttribute("disabled", "true"); setStatus("Gönderiliyor...");
      try {
        const response = await fetch(FORM_URL, { method: "POST", headers: { "Content-Type": "text/plain;charset=utf-8" }, body: JSON.stringify(payload) });
        const data = await response.json();
        if (response.ok && data?.ok) { form.reset(); if (tsInput) tsInput.value = Date.now(); setStatus("Mesajın başarıyla gönderildi."); }
        else { setStatus(data?.error || "Gönderim başarısız oldu. Lütfen tekrar dene.", true); }
      } catch { setStatus("Bağlantı hatası oluştu. Birazdan yeniden deneyebilirsin.", true); }
      finally { submitBtn?.removeAttribute("disabled"); }
    });
  </script>

  <style>
    :global(#main-header) { display: none; }
    .contact-hero { padding:1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    .contact-eyebrow { color:var(--accent); font-weight:700; text-transform:uppercase; letter-spacing:.08em; font-size:.78rem; margin-bottom:.65rem; }
    .contact-hero h2 { margin:0 0 .6rem; font-size:clamp(1.5rem, 3vw, 2.1rem); line-height:1.18; }
    .contact-hero p { color:var(--secondary); max-width:60ch; }
    .contact-form-shell { padding:1rem; }
    .contact-form { display:grid; gap:1rem; border:1px solid color-mix(in srgb, var(--border) 75%, transparent); border-radius:1rem; padding:1.1rem; background:color-mix(in srgb, var(--card-bg) 78%, transparent); }
    label { display:grid; gap:.45rem; font-weight:600; color:var(--text); }
    input, textarea { width:100%; border:1px solid var(--border); border-radius:.8rem; background:var(--muted); color:var(--text); padding:.8rem .95rem; font:inherit; }
    textarea { resize:vertical; min-height:180px; }
    input:focus, textarea:focus { outline:2px solid color-mix(in srgb, var(--accent) 45%, transparent); border-color:var(--accent); }
    .form-footer { display:grid; gap:.75rem; align-items:start; }
    button { justify-self:start; border:none; background:var(--accent); color:white; font-weight:700; border-radius:.8rem; padding:.78rem 1.15rem; cursor:pointer; transition:transform .2s ease, opacity .2s ease; }
    button:hover { transform:translateY(-1px); }
    button:disabled { opacity:.65; cursor:wait; transform:none; }
    .status { min-height:1.3rem; color:var(--secondary); }
    .status[data-state="error"] { color:#ef4444; }
    .status[data-state="ok"] { color:#22c55e; }
    .honeypot { position:absolute; left:-9999px; width:1px; height:1px; opacity:0; pointer-events:none; }
    .contact-panel { display:grid; gap:.25rem; }
    .contact-panel-title { color:var(--text); font-size:1rem; }
    .contact-panel span { color:var(--secondary); font-size:.88rem; }
    .panel-title { font-size:1rem; color:var(--text); margin-bottom:.8rem; font-weight:800; }
    .search-box { padding:0 0 1rem; margin-bottom:1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    .search-box p { font-weight:600; margin-bottom:.35rem; }
    .who-box { margin-bottom:1rem; }
    .who-list,.trend-list { list-style:none; display:flex; flex-direction:column; gap:.45rem; padding:0; margin:0; }
    .who-list li,.trend-list li { display:flex; flex-direction:column; gap:.1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 60%, transparent); padding:.55rem 0; }
    .who-list span,.contact-notes span { color:var(--secondary); font-size:.82rem; line-height:1.5; }
  </style>
</BaseLayout>
