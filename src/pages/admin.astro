---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppShell from '../components/AppShell.astro';
import Login from '../components/Login.astro';
import { getAppShellNav } from '../data/appShellNav';

const title = 'Admin Paneli';
const description = 'Sadece yönetici erişimine açık yorum moderasyon ekranı.';
const navItems = getAppShellNav('/admin');
---

<BaseLayout shellLayout={true} title={title} description={description} noindex={true}>
  <AppShell pageTitle="Admin" topbarTitle="Admin Paneli" topbarMeta="Yorum moderasyonu" navItems={navItems} showLoginSlot={true} shellClass="app-shell-focus app-shell-reading app-shell-rail-offset">
    <Fragment slot="left-login"><Login /></Fragment>
    <Fragment slot="mobile-login"><Login /></Fragment>
    <section class="admin-panel-body" data-admin-shell>
      <header class="admin-header">
        <p class="admin-kicker">Gizli Alan</p>
        <h2>Yorum Moderasyon Paneli</h2>
        <p class="admin-sub">Bekleyen yorumları buradan onaylayabilir veya silebilirsin.</p>
      </header>

      <div class="status-box" data-auth-status>Oturum kontrol ediliyor...</div>

      <section class="dashboard" data-admin-dashboard hidden>
        <div class="dashboard-top">
          <h3>Bekleyen Yorumlar</h3>
          <span class="pending-badge" data-pending-count>0</span>
        </div>

        <div class="pending-list" data-pending-list>
          <p class="muted">Yorumlar yükleniyor...</p>
        </div>
      </section>
    </section>

    <Fragment slot="right-rail">
      <div class="search-box admin-panel-note">
        <p>Panel Notu</p>
        <strong class="admin-panel-title">Sadece yetkili erişim</strong>
        <span>Bu ekran yalnızca doğrulanmış yönetici hesabına görünür. Yetkisiz kullanıcılar paneli kullanamaz.</span>
      </div>

      <section class="who-box">
        <h2 class="panel-title">Ne yapabilirsin?</h2>
        <ul class="who-list">
          <li><span>Bekleyen yorumları inceleyebilirsin.</span></li>
          <li><span>Uygun olanları onaylayabilirsin.</span></li>
          <li><span>İstenmeyen yorumları silebilir veya reddedebilirsin.</span></li>
        </ul>
      </section>
    </Fragment>
  </AppShell>

  <script>
    const ADMIN_UID = "dmX4uSaCaAfD0OvhiOa4nUp79Mv2";

    import { auth, db } from "../firebase.js";
    import { onAuthStateChanged } from "firebase/auth";
    import { collection, query, where, onSnapshot, doc, updateDoc, deleteDoc } from "firebase/firestore";

    const statusBox = document.querySelector('[data-auth-status]');
    const dashboard = document.querySelector('[data-admin-dashboard]');
    const pendingList = document.querySelector('[data-pending-list]');
    const pendingCount = document.querySelector('[data-pending-count]');

    const formatDate = (ts) => {
      if (!ts || typeof ts.toDate !== 'function') return 'Tarih yok';
      return ts.toDate().toLocaleString('tr-TR', {
        day: '2-digit',
        month: 'short',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });
    };

    const escapeHtml = (value = '') =>
      value
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');

    const sortByCreatedAtAsc = (items) => [...items].sort((a, b) => (a.createdAt?.seconds ?? 0) - (b.createdAt?.seconds ?? 0));
    let unsubscribeComments = null;

    const setUnauthorized = () => {
      if (statusBox) {
        statusBox.textContent = 'Yetkisiz erişim! Bu sayfayı görüntüleme izniniz yok.';
        statusBox.classList.add('error');
      }
      if (dashboard) dashboard.hidden = true;
      if (unsubscribeComments) { unsubscribeComments(); unsubscribeComments = null; }
    };

    const bindModerationActions = () => {
      pendingList?.querySelectorAll('[data-action]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const action = btn.dataset.action;
          const id = btn.dataset.id;
          if (!id) return;
          const prevLabel = btn.textContent;
          btn.disabled = true;
          btn.textContent = 'İşleniyor...';
          try {
            const ref = doc(db, 'comments', id);
            if (action === 'approve') await updateDoc(ref, { status: 'approved' });
            if (action === 'reject') await deleteDoc(ref);
          } catch (error) {
            console.error('Moderasyon işlemi başarısız:', error);
            btn.textContent = 'Hata';
            setTimeout(() => { btn.textContent = prevLabel; btn.disabled = false; }, 1200);
            return;
          }
          btn.textContent = prevLabel;
          btn.disabled = false;
        });
      });
    };

    const renderPending = (docs) => {
      if (!pendingList || !pendingCount) return;
      pendingCount.textContent = String(docs.length);
      if (docs.length === 0) {
        pendingList.innerHTML = '<p class="muted">Bekleyen yorum bulunmuyor.</p>';
        return;
      }
      const sorted = sortByCreatedAtAsc(docs);
      pendingList.innerHTML = sorted.map(({ id, ...data }) => {
        const authorUsername = escapeHtml(data.authorUsername || '@kullanici');
        const authorName = escapeHtml(data.authorName || 'Kullanıcı');
        const text = escapeHtml(data.text || '');
        const postId = escapeHtml(data.postId || '-');
        const createdAt = formatDate(data.createdAt);
        return `
          <article class="comment-card">
            <div class="comment-meta">
              <div class="author-stack">
                <strong>${authorUsername}</strong>
                <small>${authorName}</small>
              </div>
              <span>${createdAt}</span>
            </div>
            <p class="comment-text">${text}</p>
            <div class="comment-foot">
              <small>Post: ${postId}</small>
              <div class="comment-actions">
                <button class="approve" data-action="approve" data-id="${id}" type="button">Onayla</button>
                <button class="reject" data-action="reject" data-id="${id}" type="button">Sil / Reddet</button>
              </div>
            </div>
          </article>`;
      }).join('');
      bindModerationActions();
    };

    onAuthStateChanged(auth, (user) => {
      if (!user) {
        if (statusBox) {
          statusBox.textContent = 'Bu paneli görüntülemek için önce giriş yapmalısın.';
          statusBox.classList.remove('error');
        }
        if (dashboard) dashboard.hidden = true;
        if (unsubscribeComments) { unsubscribeComments(); unsubscribeComments = null; }
        return;
      }
      if (user.uid !== ADMIN_UID) { setUnauthorized(); return; }
      if (statusBox) {
        statusBox.textContent = `Admin doğrulandı: ${user.displayName || user.email || user.uid}`;
        statusBox.classList.remove('error');
      }
      if (dashboard) dashboard.hidden = false;
      if (unsubscribeComments) unsubscribeComments();
      const q = query(collection(db, 'comments'), where('status', '==', 'pending'));
      unsubscribeComments = onSnapshot(q, (snapshot) => {
        const items = snapshot.docs.map((d) => ({ id: d.id, ...d.data() }));
        renderPending(items);
      }, (error) => {
        console.error('Pending yorumlar çekilemedi:', error);
        if (pendingList) pendingList.innerHTML = '<p class="muted">Yorumlar alınırken bir hata oluştu.</p>';
      });
    });
  </script>

  <style>
    :global(#main-header) { display: none; }
    .admin-panel-body { padding: 1.4rem 1.5rem; display: grid; gap: 1rem; }
    .center-feed { min-width: 0; }
    .dashboard, .status-box, .admin-header { max-width: none; }
    .admin-side-rail { padding-left: 0.75rem; padding-right: 0.75rem; }
    .admin-header { border: 1px solid color-mix(in srgb, var(--border) 75%, transparent); border-radius: 16px; padding: 1.1rem; background: color-mix(in srgb, var(--muted) 45%, transparent); }
    .admin-kicker { margin: 0 0 0.3rem; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--secondary); }
    .admin-header h2 { margin: 0; font-size: clamp(1.2rem, 2.4vw, 1.8rem); }
    .admin-sub { margin: 0.35rem 0 0; color: var(--secondary); font-size: 0.95rem; }
    .status-box { border: 1px solid var(--border); border-radius: 12px; padding: 0.9rem 1rem; background: var(--card-bg); color: var(--text); }
    .status-box.error { border-color: color-mix(in srgb, #ef4444 55%, var(--border)); color: #ef4444; }
    .dashboard { border: 1px solid var(--border); border-radius: 16px; padding: 1rem; background: var(--card-bg); display: grid; gap: 0.8rem; }
    .dashboard-top { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
    .dashboard-top h3 { margin: 0; font-size: 1.05rem; }
    .pending-badge { min-width: 2rem; text-align: center; font-weight: 700; border-radius: 999px; padding: 0.3rem 0.6rem; border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border)); background: color-mix(in srgb, var(--accent) 18%, transparent); color: var(--text); }
    .pending-list { display: grid; gap: 0.75rem; }
    :global(.comment-card) { border: 1px solid var(--border); border-radius: 12px; padding: 0.85rem; background: color-mix(in srgb, var(--muted) 35%, transparent); }
    :global(.comment-meta) { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.55rem; font-size: 0.9rem; }
    :global(.author-stack) { display: grid; gap: 0.05rem; min-width: 0; }
    :global(.author-stack small) { color: var(--secondary); font-size: 0.74rem; line-height: 1.2; }
    :global(.comment-meta span) { color: var(--secondary); font-size: 0.78rem; }
    :global(.comment-text) { margin: 0; color: var(--text); line-height: 1.55; white-space: pre-wrap; overflow-wrap: anywhere; }
    :global(.comment-foot) { margin-top: 0.8rem; display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; justify-content: space-between; }
    :global(.comment-foot small) { color: var(--secondary); font-size: 0.78rem; }
    :global(.comment-actions) { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    :global(.comment-actions button) { border: 1px solid var(--border); border-radius: 999px; padding: 0.45rem 0.8rem; font-weight: 600; cursor: pointer; background: var(--card-bg); color: var(--text); }
    :global(.comment-actions button.approve) { border-color: color-mix(in srgb, #22c55e 40%, var(--border)); background: color-mix(in srgb, #22c55e 18%, transparent); }
    :global(.comment-actions button.reject) { border-color: color-mix(in srgb, #ef4444 45%, var(--border)); background: color-mix(in srgb, #ef4444 14%, transparent); }
    :global(.comment-actions button:disabled) { opacity: 0.65; cursor: wait; }
    .admin-panel-note { display:grid; gap:.25rem; padding:0 0 1rem; margin-bottom:1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    .admin-panel-title { color:var(--text); font-size:1rem; }
    .admin-panel-note span { color:var(--secondary); font-size:.88rem; line-height:1.55; }
    .panel-title { font-size:1rem; color:var(--text); margin-bottom:.8rem; font-weight:800; }
    .who-box { margin-bottom:1rem; }
    .who-list { list-style:none; display:flex; flex-direction:column; gap:.45rem; padding:0; margin:0; }
    .who-list li { display:flex; flex-direction:column; gap:.1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 60%, transparent); padding:.55rem 0; }
    .who-list span { color:var(--secondary); font-size:.82rem; line-height:1.5; }
    .muted { margin:0; color:var(--secondary); font-size:.92rem; }
  </style>
</BaseLayout>
