---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppShell from '../../components/AppShell.astro';
import Login from '../../components/Login.astro';
import { getCollection } from 'astro:content';
import { getAppShellNav } from '../../data/appShellNav';
import { authorProfiles, findAuthorByName } from '../../data/authors';

export async function getStaticPaths() {
  return authorProfiles.map((author) => ({
    params: { slug: author.slug },
    props: { author },
  }));
}

const { author } = Astro.props;

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.isDraft)
  .filter((post) => findAuthorByName(post.data.author)?.slug === author.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = `${author.name} Yazıları`;
const description = `${author.name} tarafından yazılmış tüm yazılar.`;
const navItems = getAppShellNav('/yazarlar');
---

<BaseLayout shellLayout={true} title={title} description={description}>
  <AppShell pageTitle={author.name} topbarTitle={author.name} topbarMeta={`${posts.length} yazı`} navItems={navItems} showLoginSlot={true}>
    <Fragment slot="left-login"><Login /></Fragment>
    <Fragment slot="mobile-login"><Login /></Fragment>

    <section class="author-hero">
      <div class="author-badge" style={author.color ? `--author-accent:${author.color};` : undefined}>
        {author.image ? (
          <img src={author.image} alt={author.name} class="author-image" />
        ) : (
          <div class="author-emoji">{author.emoji}</div>
        )}
      </div>

      <div class="author-copy">
        <p class="author-role">{author.role}</p>
        <h2>{author.name}</h2>
        <p class="author-bio">{author.bio}</p>
      </div>
    </section>

    <div class="author-actions">
      <a href="/yazarlar">← Tüm yazarlara dön</a>
      <span>{posts.length} yayın</span>
    </div>

    <div class="feed-list author-post-list">
      {posts.map((post) => (
        <article class="feed-item author-post-item">
          <div class="avatar mini-avatar" style={author.color ? `--avatar-accent:${author.color};` : undefined} aria-hidden="true">
            {author.image ? (
              <img class="avatar-image" src={author.image} alt={`${author.name} profil görseli`} loading="lazy" decoding="async" />
            ) : (
              author.name.slice(0, 1)
            )}
          </div>

          <div class="item-body">
            <div class="item-head">
              <span class="author">{author.name}</span>
              <span class="meta">{post.data.pubDate.toLocaleDateString('tr-TR')}</span>
            </div>

            <a class="item-title" href={`/blog/${post.id}/`}>{post.data.title}</a>
            <p class="item-desc">{post.data.description}</p>

            <div class="item-actions">
              <a class="read-more-link" href={`/blog/${post.id}/`}>Yazıyı aç →</a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <Fragment slot="right-rail">
      <div class="search-box author-panel">
        <p>Profil Özeti</p>
        <strong class="author-panel-title">{author.name}</strong>
        <span>{author.role}</span>
      </div>

      <section class="who-box">
        <h2 class="panel-title">Kısa Bilgi</h2>
        <ul class="who-list">
          <li><span>{posts.length} yayın bu profile ait</span></li>
          <li><span>Yazar profili yeni akış tasarımına entegre edildi</span></li>
          <li><span>Diğer yazarlar için /yazarlar alanına dönebilirsin</span></li>
        </ul>
      </section>

      {posts.length > 0 && (
        <section>
          <h2 class="panel-title">Son Yazı</h2>
          <ul class="trend-list latest-post-box">
            <li>
              <a href={`/blog/${posts[0].id}/`}>
                <span class="trend-tag">{posts[0].data.title}</span>
                <span class="trend-count">{posts[0].data.pubDate.toLocaleDateString('tr-TR')}</span>
              </a>
            </li>
          </ul>
        </section>
      )}
    </Fragment>
  </AppShell>

  <style>
    :global(#main-header) { display: none; }
    .author-hero { display:grid; grid-template-columns:auto 1fr; gap:1rem; padding:1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); align-items:center; }
    .author-badge { --author-accent: var(--accent); width:84px; height:84px; border-radius:24px; overflow:hidden; background:color-mix(in srgb, var(--author-accent) 18%, transparent); border:1px solid color-mix(in srgb, var(--author-accent) 35%, var(--border)); display:grid; place-items:center; }
    .author-image { width:100%; height:100%; object-fit:cover; display:block; }
    .author-emoji { font-size:2.3rem; color:var(--author-accent); }
    .author-role { color:var(--accent); font-weight:700; margin:0 0 .3rem; }
    .author-copy h2 { margin:0 0 .45rem; font-size:clamp(1.5rem, 3vw, 2rem); }
    .author-bio { color:var(--secondary); line-height:1.65; }
    .author-actions { display:flex; justify-content:space-between; align-items:center; gap:1rem; padding:.95rem 1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); color:var(--secondary); font-size:.92rem; }
    .author-actions a { color:var(--accent); text-decoration:none; font-weight:600; }
    .feed-list { display:flex; flex-direction:column; }
    .feed-item { display:grid; grid-template-columns:48px minmax(0,1fr); gap:.85rem; padding:1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); min-width:0; }
    .avatar { --avatar-accent: var(--accent); width:48px; height:48px; border-radius:16px; display:grid; place-items:center; font-weight:700; font-size:1rem; background:color-mix(in srgb, var(--avatar-accent) 18%, transparent); color:var(--avatar-accent); overflow:hidden; border:1px solid color-mix(in srgb, var(--avatar-accent) 35%, var(--border)); }
    .avatar-image { width:100%; height:100%; object-fit:cover; display:block; }
    .item-head { display:flex; gap:.45rem; margin-bottom:.25rem; font-size:.86rem; min-width:0; }
    .author { font-weight:700; color:var(--text); }
    .meta { color:var(--secondary); }
    .item-title { display:block; color:var(--text); font-size:1rem; font-weight:700; margin-bottom:.35rem; text-decoration:none; line-height:1.34; }
    .item-title:hover { color:var(--accent); }
    .item-desc { color:var(--secondary); margin-bottom:.7rem; line-height:1.55; font-size:.92rem; }
    .item-actions { display:flex; align-items:center; gap:.6rem; }
    .read-more-link { color:var(--accent); font-weight:600; text-decoration:none; padding:.28rem .45rem; border-radius:999px; }
    .read-more-link:hover { background:var(--accent-light); }
    .author-panel { display:grid; gap:.25rem; padding:0 0 1rem; margin-bottom:1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    .author-panel-title { color:var(--text); font-size:1rem; }
    .author-panel span { color:var(--secondary); font-size:.88rem; }
    .panel-title { font-size:1rem; color:var(--text); margin-bottom:.8rem; font-weight:800; }
    .search-box { padding:0 0 1rem; margin-bottom:1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    .search-box p { font-weight:600; margin-bottom:.35rem; }
    .who-box { margin-bottom:1rem; }
    .who-list,.trend-list { list-style:none; display:flex; flex-direction:column; gap:.45rem; padding:0; margin:0; }
    .who-list li,.trend-list li { display:flex; flex-direction:column; gap:.1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 60%, transparent); padding:.55rem 0; }
    .who-list span,.trend-list a { color:var(--secondary); text-decoration:none; font-size:.82rem; line-height:1.5; }
    .trend-list a { display:flex; flex-direction:column; gap:.12rem; }
    .trend-tag { color:var(--text); font-weight:600; font-size:.88rem; }
    .trend-count { color:var(--secondary); font-size:.76rem; }
    @media (max-width: 820px) { .author-hero { grid-template-columns:1fr; } .author-badge { width:72px; height:72px; border-radius:20px; } .author-actions { flex-direction:column; align-items:flex-start; } }
  </style>
</BaseLayout>

