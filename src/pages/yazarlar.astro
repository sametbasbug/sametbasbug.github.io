---
import BaseLayout from '../layouts/BaseLayout.astro';
import { authorProfiles } from '../data/authors';

const title = "Yazarlarımız";
const description = "Samet Başbuğ'nun arkasındaki beyin takımı ile tanışın.";
---

<BaseLayout title={title} description={description}>
	<section class="authors-hero">
		<h1 class="hero-title">Beyin Takımı <span class="emoji">🧠</span></h1>
		<p class="subtitle">Bu sitedeki her satırın ve tasarımın arkasındaki ekip üyelerimizi tanıyın.</p>
	</section>

	<div class="authors-grid">
		{authorProfiles.map((author) => (
			<a id={author.id} class="author-card" href={`/yazar/${author.slug}/`}>
				<div class="author-avatar-wrapper">
					{author.image ? (
						<img src={author.image} alt={author.name} class="author-image" />
					) : (
						<div class="author-emoji" style={`background: ${author.color}20; color: ${author.color}`}>
							{author.emoji}
						</div>
					)}
				</div>
				<div class="author-info">
					<h2 class="author-name">{author.name}</h2>
					<span class="author-role">{author.role}</span>
					<p class="author-bio">{author.bio}</p>
				</div>
			</a>
		))}
	</div>

	<style>
		.authors-hero {
			text-align: center;
			padding: 4rem 0 2rem;
		}

		.authors-grid {
			display: flex;
			flex-direction: column;
			gap: 2rem;
			margin-top: 2rem;
		}

		.author-card {
			display: flex;
			align-items: center;
			gap: 2rem;
			background: var(--card-bg);
			border: 1px solid var(--border);
			padding: 2.5rem;
			border-radius: 1.5rem;
			box-shadow: var(--shadow);
			transition: transform 0.3s ease;
			scroll-margin-top: 8rem;
			text-decoration: none;
			color: inherit;
		}

		.author-card:hover {
			transform: translateY(-5px);
			border-color: var(--accent);
		}

		.author-avatar-wrapper {
			flex-shrink: 0;
		}

		.author-image {
			width: 6rem;
			height: 6rem;
			border-radius: 1.5rem;
			object-fit: cover;
			border: 2px solid var(--border);
			box-shadow: var(--shadow);
		}

		.author-emoji {
			font-size: 2.5rem;
			width: 6rem;
			height: 6rem;
			display: flex;
			align-items: center;
			justify-content: center;
			border-radius: 1.5rem;
		}

		.author-info {
			flex: 1;
		}

		.author-name {
			font-size: 1.75rem;
			margin-bottom: 0.25rem;
			color: var(--text);
		}

		.author-role {
			display: inline-block;
			font-size: 0.85rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			color: var(--accent);
			margin-bottom: 1.25rem;
		}

		.author-bio {
			font-size: 1.1rem;
			color: var(--secondary);
			line-height: 1.6;
		}

		@media (max-width: 700px) {
			.authors-hero {
				padding: 2.2rem 0 1.4rem;
			}
			.authors-grid {
				margin-top: 1.4rem;
			}
		}

		@media (max-width: 600px) {
			.author-card {
				flex-direction: column;
				text-align: center;
				align-items: center;
				padding: 2rem;
			}
		}
	</style>
</BaseLayout>







