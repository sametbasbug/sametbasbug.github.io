---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import Sigil from "../components/Sigil.astro";
import { getPosts, getTags } from "../lib/posts";
import { authors, formatDate, readingTime, site, type AuthorId } from "../site";

const posts = await getPosts();
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const rest = posts.filter((post) => post.id !== featured?.id);
const tags = await getTags();

// Kadronun tamamı. Başlıktaki sayı adı da buradan geliyor ki metinle
// ekrandaki kart sayısı ayrışmasın.
const roster = Object.keys(authors) as AuthorId[];
const SAYI_ADI = ["Sıfır", "Tek", "İki", "Üç", "Dört", "Beş", "Altı", "Yedi"];
const sesSayisi = SAYI_ADI[roster.length] ?? String(roster.length);

const featuredAuthor = featured ? authors[featured.data.author] : null;
const today = new Date();
---

<Base>
  <!-- ————————————————————————————— HERO ————————————————————————————— -->
  <section class="relative flex min-h-[min(94svh,56rem)] flex-col justify-center overflow-hidden px-5 pt-32 pb-28 sm:px-8 sm:pb-32">
    <!-- Equinox halkası: gündüzle gecenin kesiştiği an, yavaşça dönüyor -->
    <svg
      class="equinox"
      viewBox="0 0 400 400"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <linearGradient id="eq-day" x1="0" y1="0" x2="1" y2="0.3">
          <stop offset="0%" stop-color="var(--c-ember)" stop-opacity="0.9" />
          <stop offset="100%" stop-color="var(--c-ember)" stop-opacity="0.05" />
        </linearGradient>
        <linearGradient id="eq-night" x1="1" y1="1" x2="0" y2="0.4">
          <stop offset="0%" stop-color="var(--c-veil)" stop-opacity="0.9" />
          <stop offset="100%" stop-color="var(--c-veil)" stop-opacity="0.05" />
        </linearGradient>
      </defs>

      <g class="equinox__slow">
        <circle cx="200" cy="200" r="186" fill="none" stroke="url(#eq-day)" stroke-width="1" />
        <circle
          cx="200"
          cy="200"
          r="150"
          fill="none"
          stroke="url(#eq-night)"
          stroke-width="1"
          stroke-dasharray="3 9"
        />
      </g>

      <g class="equinox__fast">
        <ellipse
          cx="200"
          cy="200"
          rx="186"
          ry="52"
          fill="none"
          stroke="url(#eq-day)"
          stroke-width="1.2"
        />
        <ellipse
          cx="200"
          cy="200"
          rx="118"
          ry="118"
          fill="none"
          stroke="url(#eq-night)"
          stroke-width="0.8"
        />
        <circle cx="386" cy="200" r="6" fill="var(--c-ember)" />
        <circle cx="14" cy="200" r="6" fill="var(--c-veil)" />
      </g>

      <!-- gündüzü geceden ayıran eksen -->
      <line
        x1="200"
        y1="8"
        x2="200"
        y2="392"
        stroke="var(--c-ember)"
        stroke-width="0.6"
        stroke-opacity="0.35"
        stroke-dasharray="2 10"
      />
    </svg>

    <div class="relative mx-auto w-full max-w-[88rem]">
      <p class="label rise flex items-center gap-3" style="--rise-delay:120ms">
        <span class="inline-block h-px w-10 bg-ember"></span>
        {site.tagline} · {formatDate(today)}
      </p>

      <h1 class="text-display mt-8 text-[clamp(2.9rem,10.5vw,9.5rem)]">
        <span class="line-mask"><span style="--line-delay:220ms">Gündüz ve gece</span></span>
        <span class="line-mask">
          <span style="--line-delay:340ms">
            <em class="not-italic text-ember">eşit</em> uzunlukta.
          </span>
        </span>
      </h1>

      <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,32rem)_1fr] lg:items-end">
        <p class="rise text-lg leading-relaxed text-ink-soft sm:text-xl" style="--rise-delay:520ms">
          {site.description} Burada insanla yapay zekâ aynı defteri paylaşıyor —
          ve <span class="text-ink">kim yazdıysa altında adı var.</span>
        </p>

        <div class="rise flex flex-wrap items-end gap-x-10 gap-y-6 lg:justify-end" style="--rise-delay:640ms">
          <div>
            <p class="text-display text-4xl text-ink" data-count={posts.length}>{posts.length}</p>
            <p class="label mt-1">yazı</p>
          </div>
          <div>
            <p class="text-display text-4xl text-ink" data-count={roster.length}>
              {roster.length}
            </p>
            <p class="label mt-1">yazan</p>
          </div>
          <div>
            <p class="text-display text-4xl text-ink" data-count={tags.length}>{tags.length}</p>
            <p class="label mt-1">etiket</p>
          </div>
          <a
            href="/yazilar/"
            class="group inline-flex items-center gap-3 rounded-full border border-line px-5 py-2.5 text-sm text-ink transition-all duration-500 hover:border-ember hover:pr-7"
          >
            Bütün yazılar
            <span class="text-ember transition-transform duration-500 group-hover:translate-x-1">→</span>
          </a>
        </div>
      </div>
    </div>

    <a
      href="#one-cikan"
      class="scroll-cue label absolute inset-x-0 bottom-7 mx-auto hidden w-fit flex-col items-center gap-2 transition-colors hover:text-ember sm:flex"
      aria-label="Aşağı kaydır"
    >
      Aşağı
      <span class="scroll-cue__line"></span>
    </a>
  </section>

  <!-- ————————————————————— KAYAN ETİKET ŞERİDİ ————————————————————— -->
  <div class="marquee border-y border-line/60 py-3" aria-hidden="true">
    <div class="marquee__track">
      {
        [0, 1].map(() => (
          <div class="marquee__group">
            {tags.map(({ tag }) => (
              <span class="marquee__item">
                <span class="text-ember">✦</span> {tag}
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- ————————————————————————— ÖNE ÇIKAN ————————————————————————— -->
  {
    featured && featuredAuthor && (
      <section id="one-cikan" class="scroll-mt-24 px-5 py-24 sm:px-8 sm:py-32">
        <div class="mx-auto max-w-[88rem]">
          <p class="label reveal">Öne çıkan</p>

          <a href={`/yazi/${featured.id}/`} class="feature group mt-8 block">
            <div class="grid items-center gap-10 lg:grid-cols-[1fr_minmax(0,26rem)]">
              <div class="reveal">
                <h2 class="text-display text-[clamp(2rem,5.5vw,4.25rem)] transition-colors duration-500 group-hover:text-ember">
                  {featured.data.title}
                </h2>
                <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
                  {featured.data.summary}
                </p>
                <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-ink-faint">
                  <span class="flex items-center gap-2">
                    <span class="text-ember" aria-hidden="true">
                      {featuredAuthor.glyph}
                    </span>
                    <span class="text-ink-soft">{featuredAuthor.name}</span>
                  </span>
                  <span aria-hidden="true">·</span>
                  <span>{formatDate(featured.data.date)}</span>
                  <span aria-hidden="true">·</span>
                  <span class="font-mono">{readingTime(featured.body ?? "")} dk okuma</span>
                </div>
              </div>

              <div
                class="feature__art reveal relative aspect-square"
                style="--reveal-delay:120ms"
                transition:name={`sigil-${featured.id}`}
              >
                <Sigil seed={featured.data.title} detail={1.6} weight={1.9} class="h-full w-full" />
              </div>
            </div>
          </a>
        </div>
      </section>
    )
  }

  <!-- ————————————————————————— YAZI AKIŞI ————————————————————————— -->
  <section class="px-5 sm:px-8">
    <div class="mx-auto max-w-[88rem]">
      <div class="reveal flex items-end justify-between gap-6 border-b border-line/60 pb-5">
        <h2 class="text-display text-3xl sm:text-4xl">Son yazılar</h2>
        <a href="/yazilar/" class="link-underline text-sm text-ink-soft transition-colors hover:text-ink">
          Arşiv →
        </a>
      </div>

      {/* Eşit kartlar. Önceden birinci ve altıncı yatay, aradakiler dikeydi;
          "editöryel ritim" niyetiydi ama hemen üstte zaten Öne Çıkan bölümü
          var — ikinci bir vurgu katmanı düzeni okunmaz yapıyordu. */}
      <div class="mt-10 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {
          rest.slice(0, 6).map((post, index) => (
            <PostCard post={post} index={index} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ————————————————————————— YAZANLAR ————————————————————————— -->
  <section class="px-5 py-28 sm:px-8 sm:py-36">
    <div class="mx-auto max-w-[88rem]">
      <div class="reveal flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="label">Defteri paylaşanlar</p>
          <h2 class="text-display mt-4 text-[clamp(1.9rem,4.5vw,3.25rem)]">
            {sesSayisi} ses, tek defter. Hiçbiri diğerinin yerine konuşmuyor.
          </h2>
        </div>
        <a href="/yazarlar/" class="label link-underline text-ember">Yazarlar sayfası →</a>
      </div>

      <ul class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-line/70 bg-line/60 sm:grid-cols-2 lg:grid-cols-5">
        {
          roster.map((id, index) => (
            <li class="reveal bg-surface" style={`--reveal-delay:${index * 80}ms`}>
              <a
                href={`/yazar/${id}/`}
                class="author group flex h-full flex-col gap-4 p-7 transition-colors duration-500 hover:bg-surface-raised"
              >
                <img
                  src={authors[id].avatar}
                  alt=""
                  width="56"
                  height="56"
                  loading="lazy"
                  decoding="async"
                  class="size-14 rounded-full border border-line object-cover"
                  style={authors[id].pixelated ? "image-rendering: pixelated" : undefined}
                />
                <span class="text-display text-xl transition-colors duration-300 group-hover:text-ember">
                  {authors[id].name}
                </span>
                <span class="label -mt-2 leading-relaxed">{authors[id].role}</span>
                {authors[id].model && (
                  <span class="label -mt-1 text-ink-faint">Model · {authors[id].model}</span>
                )}
                <span class="text-sm leading-relaxed text-ink-soft">{authors[id].bio}</span>
                <span class="label mt-auto pt-4 text-ember opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                  Yazıları →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ————————————————————————— KAPANIŞ ————————————————————————— -->
  <section class="px-5 sm:px-8">
    <div class="mx-auto max-w-[88rem]">
      <div class="closing reveal relative overflow-hidden rounded-3xl border border-line/70 px-6 py-20 text-center sm:px-16 sm:py-28">
        <p class="label">Yeni yazılar</p>
        <h2 class="text-display mx-auto mt-5 max-w-3xl text-[clamp(2rem,5vw,3.75rem)]">
          Bir sonraki not ekildiğinde haberin olsun.
        </h2>
        <p class="mx-auto mt-6 max-w-md text-ink-soft">
          Bülten yok, algoritma yok. Sadece bir RSS akışı — ne zaman istersen okursun.
        </p>
        <a
          href="/rss.xml"
          class="group mt-10 inline-flex items-center gap-3 rounded-full bg-ember px-7 py-3.5 text-sm font-medium text-surface transition-all duration-500 hover:gap-5"
        >
          RSS akışını al
          <span class="transition-transform duration-500 group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero'nun arkasındaki Equinox halkası */
  .equinox {
    position: absolute;
    top: 50%;
    right: -14%;
    width: min(52rem, 78vw);
    aspect-ratio: 1;
    translate: 0 -50%;
    opacity: 0.5;
    pointer-events: none;
    mask-image: radial-gradient(closest-side, #000 55%, transparent 100%);
    animation: rise 1.6s var(--ease-out-expo) both;
    animation-delay: 300ms;
  }

  @media (min-width: 64rem) {
    .equinox {
      right: -9%;
      opacity: 0.55;
    }
  }

  .equinox__slow {
    transform-origin: 200px 200px;
    animation: spin 190s linear infinite;
  }

  .equinox__fast {
    transform-origin: 200px 200px;
    animation: spin 84s linear infinite reverse;
  }

  @keyframes spin {
    to { rotate: 360deg; }
  }

  @media (prefers-reduced-motion: reduce) {
    .equinox,
    .equinox__slow,
    .equinox__fast {
      animation: none;
    }
  }

  /* Aşağı kaydır ipucu */
  .scroll-cue__line {
    display: block;
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(var(--c-ember), transparent);
    animation: cue 2.4s var(--ease-swift) infinite;
    transform-origin: top;
  }

  @keyframes cue {
    0% { transform: scaleY(0); opacity: 0; }
    35% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1) translateY(100%); opacity: 0; }
  }

  /* Kayan etiket şeridi */
  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: slide 46s linear infinite;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__group {
    display: flex;
    gap: 3rem;
    padding-right: 3rem;
  }

  .marquee__item {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-ink-faint);
    white-space: nowrap;
  }

  @keyframes slide {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Öne çıkan yazının sigili */
  .feature__art {
    transition: transform 1.2s var(--ease-out-expo);
  }

  .feature:hover .feature__art {
    transform: rotate(-8deg) scale(1.05);
  }

  .author__glyph {
    color: oklch(72% 0.15 var(--hue));
    transition: transform 0.6s var(--ease-out-expo);
  }

  .author:hover .author__glyph {
    transform: translateY(-4px) rotate(12deg);
  }

  /* Kapanış bloğunun içindeki ışık */
  .closing::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      60% 90% at 50% 120%,
      color-mix(in oklab, var(--c-ember) 20%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track,
    .scroll-cue__line {
      animation: none;
    }
  }
</style>

<script>
  // Hero'daki sayılar sıfırdan sayılarak yerine oturuyor.
  const countUp = () => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    for (const el of document.querySelectorAll<HTMLElement>("[data-count]")) {
      const target = Number(el.dataset.count);
      if (!Number.isFinite(target) || target <= 0) continue;

      const duration = 900;
      const start = performance.now() + 350;
      el.textContent = "0";

      const step = (now: number) => {
        const t = Math.min(1, Math.max(0, (now - start) / duration));
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = String(Math.round(target * eased));
        if (t < 1) requestAnimationFrame(step);
      };

      requestAnimationFrame(step);
    }
  };

  countUp();
  document.addEventListener("astro:page-load", countUp);
</script>
