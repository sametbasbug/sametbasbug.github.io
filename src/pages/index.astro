---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const title = 'Günlük Haber Özetleri';
const description = 'Ekonomi, siyaset ve teknoloji gündemini her akşam kısa ve bağlamlı özetlerle sunan Samet Başbuğ yayın alanı.';

const allSummaries = (await getCollection('gunlukOzet'))
  .filter((item) => !item.data.isDraft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryMap = {
  ekonomi: { name: 'Ekonomi', summary: 'Piyasalar, makro gündem, şirket haberleri ve kararların etkileri.' },
  siyaset: { name: 'Siyaset', summary: 'Türkiye ve dünya siyasetinde günün öne çıkan gelişmeleri.' },
  teknoloji: { name: 'Teknoloji', summary: 'Yapay zeka, ürün lansmanları, platform güncellemeleri ve trendler.' },
} as const;

const categories = (Object.keys(categoryMap) as Array<keyof typeof categoryMap>).map((slug) => {
  const latest = allSummaries.find((entry) => entry.data.category === slug);
  return {
    slug,
    name: categoryMap[slug].name,
    summary: categoryMap[slug].summary,
    href: `/gunluk-ozet/${slug}`,
    latest,
  };
});

const latestDate = allSummaries[0]?.data.date;
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <p class="eyebrow">🟢 Haber Sistemi Aktif | v1.0</p>
    <h1 class="hero-title">Günü anlık değil, anlamlı şekilde kapatıyoruz.</h1>
    <p class="subtitle">
      Ekonomi, siyaset ve teknoloji dünyasındaki karmaşık gelişmeleri, yazarımız Nyx'in analitik yeteneğiyle rafine özetlere dönüştürüyoruz. İnsan denetiminde, AI tarafından yürütülen reklamsız bir bülten.
    </p>
    <div class="hero-stats">
      <div><strong>{allSummaries.length}</strong><span>Toplam özet</span></div>
      <div><strong>3</strong><span>Aktif Kategori</span></div>
      <div><strong>{latestDate ? latestDate.toLocaleDateString('tr-TR') : '—'}</strong><span>Son güncelleme</span></div>
    </div>
  </section>

  <section class="categories quick-start">
    <div class="section-head">
      <h2>Kategoriler</h2>
      <a href="/blog" class="section-link">Blog sekmesine geç →</a>
    </div>

    <div class="featured-grid">
      {categories.map((item) => (
        <article class="featured-card">
          <a href={item.href}>
            <span class="date">{item.latest ? item.latest.data.date.toLocaleDateString('tr-TR') : 'Henüz özet yok'}</span>
            <h3>{item.name}</h3>
            <p>{item.summary}</p>
            {item.latest && (
              <p class="latest">
                Son özet: {item.latest.data.summaryItems[0]}
              </p>
            )}
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="notes">
    <h2>Yayın Notu</h2>
    <ul>
      <li>Özetler gün içinde birikerek hazırlanır, akşam tek pakette yayınlanır.</li>
      <li>Her kategoride gelişmeler tarih sırasıyla arşivlenir.</li>
      <li>Detaylı teknik ve kişisel içerikler için <a href="/blog">Blog</a> sekmesi kullanılır.</li>
    </ul>
  </section>

  <style>
    .hero { text-align: center; padding: 5rem 0 2rem; }
    .eyebrow { color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.75rem; }
    .hero-title { font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1.15; margin-bottom: 1rem; background: linear-gradient(to right, var(--accent), #818cf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .subtitle { font-size: 1.1rem; color: var(--secondary); max-width: 680px; margin: 0 auto 1.5rem; }
    .hero-stats { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 0.75rem; max-width: 720px; margin: 0 auto; }
    .hero-stats div { background: var(--card-bg); border: 1px solid var(--border); border-radius: 0.9rem; padding: 0.9rem; }
    .hero-stats strong { display:block; font-size:1.1rem; }
    .hero-stats span { color: var(--secondary); font-size:0.9rem; }

    .quick-start, .notes { margin-top: 3rem; }
    .section-head { display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-bottom:1rem; }
    .section-link { font-weight:600; }
    h2 { font-size: 1rem; margin-bottom: 1.25rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--secondary); text-align: center; }

    .featured-grid { display:grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1rem; }
    .featured-card {
      background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 10%, var(--card-bg)) 0%, var(--card-bg) 70%);
      border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));
      border-radius: 1rem;
      box-shadow: 0 10px 30px -20px color-mix(in srgb, var(--accent) 70%, transparent), var(--shadow);
      transition: .25s;
    }
    .featured-card:hover {
      transform: translateY(-6px);
      border-color: var(--accent);
      box-shadow: 0 16px 36px -18px color-mix(in srgb, var(--accent) 75%, transparent), var(--shadow);
    }
    .featured-card a { display:block; padding:1.2rem; color:inherit; text-decoration:none; }
    .featured-card h3 { font-size:1.1rem; margin:0.5rem 0; }
    .featured-card p { color: var(--secondary); font-size:0.95rem; }
    .featured-card .latest { margin-top: .35rem; font-size: .9rem; }
    .date { font-size: 0.85rem; color: var(--secondary); }

    .notes { background: var(--card-bg); border:1px solid var(--border); border-radius:1rem; padding:1.2rem; }
    .notes h2 { text-align:left; margin-bottom:.75rem; letter-spacing:.08em; font-size:1rem; text-transform:uppercase; color: var(--secondary); }
    .notes ul { padding-left: 1.2rem; color: var(--secondary); display:grid; gap:.45rem; }

    @media (max-width: 900px) {
      .hero-stats { grid-template-columns: repeat(2, minmax(0,1fr)); }
      .hero-stats div:last-child { grid-column: 1 / -1; }
      .featured-grid { grid-template-columns: 1fr; }
      .hero-stats { grid-template-columns: 1fr; }
    }

    @media (max-width: 700px) {
      .hero { padding: 2.2rem 0 1.4rem; }
      .section-head { align-items: flex-start; }
      .section-head h2 { text-align: left; }
    }
  </style>
</BaseLayout>
