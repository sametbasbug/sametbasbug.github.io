---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppShell from '../components/AppShell.astro';
import Login from '../components/Login.astro';
import { getAppShellNav } from '../data/appShellNav';

const title = 'Sayfa Bulunamadı';
const description = 'Aradığınız sayfa mevcut değil, taşınmış olabilir ya da artık bu evrende yaşamıyor.';
const navItems = getAppShellNav();
---

<BaseLayout shellLayout={true} title={title} description={description} noindex={true}>
  <AppShell pageTitle="404" topbarTitle="404" topbarMeta="Yol kayboldu" navItems={navItems} showLoginSlot={true}>
    <Fragment slot="left-login"><Login /></Fragment>
    <Fragment slot="mobile-login"><Login /></Fragment>
    <section class="error-hero">
      <p class="error-code">404</p>
      <h2>Aradığın sayfa burada değil.</h2>
      <p>Link taşınmış olabilir, içerik emekliye ayrılmış olabilir ya da adres çubuğunda küçük bir yazım kazası yaşanmış olabilir.</p>
      <div class="error-actions">
        <a href="/" class="btn btn-primary">Ana Sayfaya Dön</a>
        <a href="/" class="btn btn-secondary">İçerikleri Keşfet</a>
      </div>
    </section>

    <Fragment slot="right-rail">
      <div class="search-box error-panel">
        <p>Ne yapabilirsin?</p>
        <strong class="error-panel-title">Geri dön ve keşfet</strong>
        <span>Ana sayfaya dönerek içerik akışını ve yazarları yeniden keşfedebilirsin.</span>
      </div>
      <section class="who-box">
        <h2 class="panel-title">Hızlı Kaçışlar</h2>
        <ul class="who-list">
          <li><a href="/"><strong>Ana Sayfa</strong><span>Güncel içerik akışı</span></a></li>
          <li><a href="/yazarlar"><strong>Yazarlar</strong><span>Profil ve roller</span></a></li>
        </ul>
      </section>
    </Fragment>
  </AppShell>

  <style>
    :global(#main-header), :global(#main-footer) { display: none; }
    .error-hero { min-height: calc(100vh - 9rem); display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:2rem 1.5rem; }
    .error-code { font-size:clamp(5rem, 18vw, 9rem); font-weight:800; line-height:1; margin-bottom:1rem; background:linear-gradient(to bottom right, var(--accent), #818cf8); -webkit-background-clip:text; -webkit-text-fill-color:transparent; opacity:.28; }
    .error-hero h2 { font-size:clamp(1.8rem, 4vw, 3rem); margin-bottom:1rem; line-height:1.1; }
    .error-hero p:not(.error-code) { color:var(--secondary); font-size:1.05rem; max-width:42rem; line-height:1.7; }
    .error-actions { display:flex; flex-wrap:wrap; gap:1rem; justify-content:center; margin-top:2rem; }
    .btn { padding:.85rem 1.3rem; border-radius:.9rem; font-weight:700; text-decoration:none; transition:all .2s; }
    .btn-primary { background:var(--accent); color:white; box-shadow:var(--shadow); }
    .btn-primary:hover { transform:translateY(-2px); filter:brightness(1.08); }
    .btn-secondary { background:color-mix(in srgb, var(--card-bg) 85%, transparent); color:var(--text); border:1px solid var(--border); }
    .btn-secondary:hover { background:var(--muted); transform:translateY(-2px); }
    .error-panel { display:grid; gap:.25rem; padding:0 0 1rem; margin-bottom:1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    .error-panel-title { color:var(--text); font-size:1rem; }
    .error-panel span { color:var(--secondary); font-size:.88rem; line-height:1.55; }
    .panel-title { font-size:1rem; color:var(--text); margin-bottom:.8rem; font-weight:800; }
    .who-box { margin-bottom:1rem; }
    .who-list { list-style:none; display:flex; flex-direction:column; gap:.45rem; padding:0; margin:0; }
    .who-list a { display:flex; flex-direction:column; gap:.1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 60%, transparent); padding:.55rem 0; text-decoration:none; }
    .who-list strong { color:var(--text); font-size:.9rem; }
    .who-list span { color:var(--secondary); font-size:.82rem; line-height:1.5; }
  </style>
</BaseLayout>
