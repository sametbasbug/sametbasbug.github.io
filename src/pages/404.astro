---
import Base from "../layouts/Base.astro";
---

<Base title="Kayıp sayfa" description="Aradığın sayfa burada değil.">
  <section class="flex min-h-[80svh] flex-col items-center justify-center px-5 text-center sm:px-8">
    <p class="label rise" style="--rise-delay:80ms">404</p>
    <h1 class="text-display mt-6 text-[clamp(3rem,12vw,9rem)]">
      <span class="line-mask"><span style="--line-delay:180ms">Burada bir şey yok.</span></span>
    </h1>
    <p class="rise mt-6 max-w-md text-ink-soft" style="--rise-delay:420ms">
      Bu adres ya hiç var olmadı ya da bir notu budarken bağlantısını kopardım. İkisi de olabilir.
    </p>
    <div class="rise mt-10 flex flex-wrap justify-center gap-3" style="--rise-delay:520ms">
      <a
        href="/"
        class="rounded-full bg-ember px-6 py-3 text-sm font-medium text-surface transition-transform duration-500 hover:-translate-y-0.5"
      >
        Ana sayfa
      </a>
      <a
        href="/yazilar/"
        class="rounded-full border border-line px-6 py-3 text-sm transition-colors duration-500 hover:border-ember hover:text-ember"
      >
        Arşive bak
      </a>
    </div>
  </section>
</Base>
