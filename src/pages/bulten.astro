---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppShell from '../components/AppShell.astro';
import Login from '../components/Login.astro';
import { getCollection } from 'astro:content';
import { getAppShellNav } from '../data/appShellNav';

const title = 'Bülten';
const description = 'Günlük haber özetlerinin akış kabuğuna taşınmış bülten görünümü.';

const allSummaries = (await getCollection('gunlukOzet'))
  .filter((item) => !item.data.isDraft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryMap = {
  ekonomi: { name: 'Ekonomi', summary: 'Piyasalar, makro gündem, şirket haberleri ve kararların etkileri.' },
  siyaset: { name: 'Siyaset', summary: 'Türkiye ve dünya siyasetinde günün öne çıkan gelişmeleri.' },
  teknoloji: { name: 'Teknoloji', summary: 'Yapay zeka, ürün lansmanları, platform güncellemeleri ve trendler.' },
} as const;

const categories = (Object.keys(categoryMap) as Array<keyof typeof categoryMap>).map((slug) => {
  const latest = allSummaries.find((entry) => entry.data.category === slug);
  return {
    slug,
    name: categoryMap[slug].name,
    summary: categoryMap[slug].summary,
    href: `/gunluk-ozet/${slug}`,
    latest,
  };
});

const latestDate = allSummaries[0]?.data.date;
const navItems = getAppShellNav('/bulten');
const formatDate = (date: Date) =>
  date.toLocaleDateString('tr-TR', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  });
---

<BaseLayout shellLayout={true} title={title} description={description}>
  <AppShell pageTitle="Bülten" topbarTitle="Bülten" topbarMeta={`${allSummaries.length} özet`} navItems={navItems} showLoginSlot={true}>
    <Fragment slot="left-login"><Login /></Fragment>
    <Fragment slot="mobile-login"><Login /></Fragment>

    <div slot="mobile-hub">
      <label class="mobile-search" aria-label="Ara">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4a6 6 0 1 1 0 12 6 6 0 0 1 0-12Zm0-2a8 8 0 1 0 4.9 14.3l5.4 5.4 1.4-1.4-5.4-5.4A8 8 0 0 0 10 2Z"/></svg>
        <input id="bulletin-search-mobile" type="search" placeholder="Bülten içinde ara" />
      </label>
      <div class="mobile-cats" aria-label="Kategoriler">
        {categories.map((item) => (
          <a href={item.href}>{item.name}</a>
        ))}
      </div>
    </div>

    <div class="bulletin-hero">
      <p class="bulletin-eyebrow">🟢 Haber Sistemi Aktif | v1.0</p>
      <h2>Günü anlık değil, anlamlı şekilde kapatıyoruz.</h2>
      <p>
        Ekonomi, siyaset ve teknoloji dünyasındaki karmaşık gelişmeleri rafine özetlere dönüştüren bülten alanı.
        Aynı kabuk, farklı ritim.
      </p>
    </div>

    <div class="bulletin-stats">
      <div><strong>{allSummaries.length}</strong><span>Toplam özet</span></div>
      <div><strong>3</strong><span>Aktif kategori</span></div>
      <div><strong>{latestDate ? latestDate.toLocaleDateString('tr-TR') : '—'}</strong><span>Son güncelleme</span></div>
    </div>

    <div class="feed-list bulletin-list">
      {categories.map((item) => (
        <article class="feed-item bulletin-item" data-search={`${item.name} ${item.summary} ${item.latest?.data.summaryItems?.join(' ') ?? ''}`.toLocaleLowerCase('tr-TR')}>
          <div class="avatar bulletin-avatar" aria-hidden="true">{item.name.slice(0, 1)}</div>
          <div class="item-body">
            <div class="item-head">
              <span class="author">{item.name}</span>
              <span class="meta">{item.latest ? formatDate(item.latest.data.date) : 'Henüz yayın yok'}</span>
            </div>
            <a class="item-title" href={item.href}>{item.name} Bülteni</a>
            <p class="item-desc">{item.summary}</p>
            {item.latest && (
              <div class="bulletin-points">
                {item.latest.data.summaryItems.slice(0, 3).map((point) => <p>{point}</p>)}
              </div>
            )}
            <div class="item-actions">
              <span class="date-meta">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2h2v2h6V2h2v2h3v18H4V4h3V2Zm11 8H6v10h12V10Z"/></svg>
                <span>{item.latest ? formatDate(item.latest.data.date) : 'Arşiv bekleniyor'}</span>
              </span>
              <a class="read-more-link" href={item.href}>Bülteni aç →</a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <Fragment slot="right-rail">
      <div class="search-box">
        <p>Ara</p>
        <input id="bulletin-search-input" type="search" placeholder="Kategori veya özet ara..." />
        <a href="/gunluk-ozet">Tüm bülten arşivine geç →</a>
      </div>
      <section class="who-box">
        <h2 class="panel-title">Kategoriler</h2>
        <ul class="who-list">
          {categories.map((item) => (
            <li>
              <a href={item.href} class="bulletin-filter-link" data-filter={item.name.toLocaleLowerCase('tr-TR')}>
                <strong>{item.name}</strong>
                <span>{item.latest ? formatDate(item.latest.data.date) : 'Henüz yayın yok'}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
      <section>
        <h2 class="panel-title">Yayın Notu</h2>
        <ul class="trend-list bulletin-notes">
          <li><span>Özetler gün içinde birikir, akşam tek pakette yayınlanır.</span></li>
          <li><span>Her kategori tarih sırasıyla arşivlenir.</span></li>
          <li><span>Detaylı teknik ve kişisel içerikler doğrudan ana içerik akışı içinde yer alır.</span></li>
        </ul>
      </section>
    </Fragment>
  </AppShell>

  <script>
    function initBulletinSearch() {
      const desktopInput = document.getElementById('bulletin-search-input');
      const mobileInput = document.getElementById('bulletin-search-mobile');
      const items = Array.from(document.querySelectorAll('.bulletin-item'));
      if ((!desktopInput && !mobileInput) || items.length === 0) return;

      const applyFilter = (raw) => {
        const query = (raw || '').toLocaleLowerCase('tr-TR').trim();
        items.forEach((item) => {
          const haystack = (item.getAttribute('data-search') || '').toLocaleLowerCase('tr-TR');
          item.style.display = !query || haystack.includes(query) ? '' : 'none';
        });
      };

      const bind = (input, twin) => {
        if (!input || input.dataset.bound === '1') return;
        input.dataset.bound = '1';
        input.addEventListener('input', () => {
          if (twin && twin.value !== input.value) twin.value = input.value;
          applyFilter(input.value);
        });
      };

      bind(desktopInput, mobileInput);
      bind(mobileInput, desktopInput);

      document.querySelectorAll('.bulletin-filter-link').forEach((link) => {
        if (link.dataset.bound === '1') return;
        link.dataset.bound = '1';
        link.addEventListener('click', (event) => {
          event.preventDefault();
          const filter = link.getAttribute('data-filter') || '';
          if (desktopInput) desktopInput.value = filter;
          if (mobileInput) mobileInput.value = filter;
          applyFilter(filter);
        });
      });

      applyFilter(desktopInput?.value || mobileInput?.value || '');
    }

    initBulletinSearch();
    document.addEventListener('astro:page-load', initBulletinSearch);
  </script>

  <style>
    :global(#main-header) { display: none; }
    .bulletin-hero { padding:1.15rem 1rem .6rem; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    .bulletin-eyebrow { color:var(--accent); font-weight:700; text-transform:uppercase; letter-spacing:.08em; margin-bottom:.65rem; font-size:.78rem; }
    .bulletin-hero h2 { margin:0 0 .55rem; font-size:clamp(1.45rem, 3vw, 2rem); line-height:1.2; }
    .bulletin-hero p { color:var(--secondary); max-width:62ch; }
    .bulletin-stats { display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:.75rem; padding:.95rem 1rem 1.1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    .bulletin-stats div { background:color-mix(in srgb, var(--card-bg) 70%, transparent); border:1px solid color-mix(in srgb, var(--border) 70%, transparent); border-radius:.9rem; padding:.85rem .9rem; }
    .bulletin-stats strong { display:block; font-size:1.05rem; }
    .bulletin-stats span { color:var(--secondary); font-size:.88rem; }
    .feed-list { display:flex; flex-direction:column; }
    .feed-item { display:grid; grid-template-columns:42px minmax(0, 1fr); gap:.75rem; padding:.8rem .9rem; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); min-width:0; }
    .avatar { width:42px; height:42px; border-radius:50%; display:grid; place-items:center; font-weight:700; font-size:.85rem; background:color-mix(in srgb, var(--accent) 22%, transparent); color:var(--accent); overflow:hidden; border:1px solid color-mix(in srgb, var(--accent) 35%, var(--border)); }
    .bulletin-avatar { background:linear-gradient(135deg, color-mix(in srgb, var(--accent) 20%, transparent), color-mix(in srgb, #818cf8 22%, transparent)); }
    .item-head { display:flex; align-items:center; gap:.4rem; margin-bottom:.2rem; font-size:.86rem; min-width:0; white-space:nowrap; }
    .author { font-weight:700; color:var(--text); }
    .meta { color:var(--secondary); overflow:hidden; text-overflow:ellipsis; }
    .item-title { display:block; color:var(--text); font-size:.98rem; font-weight:700; margin-bottom:.3rem; text-decoration:none; line-height:1.34; }
    .item-title:hover { color:var(--accent); }
    .item-desc { color:var(--secondary); margin-bottom:.55rem; line-height:1.48; font-size:.9rem; }
    .bulletin-points { display:grid; gap:.45rem; margin-bottom:.7rem; }
    .bulletin-points p { position:relative; padding-left:.95rem; color:var(--secondary); font-size:.88rem; line-height:1.5; }
    .bulletin-points p::before { content:''; position:absolute; left:0; top:.58rem; width:.4rem; height:.4rem; border-radius:50%; background:var(--accent); }
    .item-actions { display:flex; flex-wrap:wrap; align-items:center; gap:.6rem; color:var(--secondary); font-size:.82rem; min-width:0; }
    .date-meta { display:inline-flex; align-items:center; gap:.28rem; color:var(--secondary); padding:.28rem .45rem; border-radius:999px; }
    .date-meta svg { width:15px; height:15px; fill:currentColor; }
    .item-actions .read-more-link { color:var(--accent); font-weight:600; text-decoration:none; margin-left:auto; padding:.28rem .45rem; border-radius:999px; }
    .item-actions .read-more-link:hover { background:var(--accent-light); }
    .panel-title { font-size:1rem; letter-spacing:.02em; text-transform:none; color:var(--text); margin-bottom:.8rem; font-weight:800; }
    .search-box { padding:0 0 1rem; margin-bottom:1rem; background:transparent; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    .search-box p { font-weight:600; margin-bottom:.35rem; }
    .search-box input { width:100%; border:1px solid color-mix(in srgb, var(--border) 70%, transparent); background:color-mix(in srgb, white 6%, transparent); color:var(--secondary); padding:.55rem .65rem; border-radius:999px; margin-bottom:.45rem; }
    .search-box a { color:var(--accent); font-size:.9rem; text-decoration:none; }
    .who-box { margin-bottom:1rem; }
    .who-list,.trend-list { list-style:none; display:flex; flex-direction:column; gap:.45rem; padding:0; margin:0; }
    .who-list a,.trend-list li { display:flex; flex-direction:column; gap:.1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 60%, transparent); background:transparent; padding:.55rem 0; text-decoration:none; }
    .who-list strong { color:var(--text); font-size:.9rem; }
    .who-list span,.bulletin-notes span { color:var(--secondary); font-size:.78rem; line-height:1.5; }
    .mobile-search { display:flex; align-items:center; gap:.45rem; border:1px solid color-mix(in srgb, var(--border) 70%, transparent); background:color-mix(in srgb, white 6%, transparent); color:var(--secondary); border-radius:999px; padding:.48rem .75rem; margin-bottom:.65rem; }
    .mobile-search svg { width:14px; height:14px; fill:currentColor; flex-shrink:0; }
    .mobile-search input { width:100%; border:0; background:transparent; color:var(--secondary); font-size:.88rem; outline:none; }
    .mobile-cats { display:flex; gap:.45rem; overflow-x:auto; padding-bottom:.1rem; scrollbar-width:none; -ms-overflow-style:none; }
    .mobile-cats::-webkit-scrollbar { display:none; }
    .mobile-cats a { white-space:nowrap; color:var(--secondary); border:1px solid var(--border); background:var(--muted); border-radius:999px; padding:.32rem .65rem; font-size:.8rem; text-decoration:none; }
    @media (max-width: 820px) { .bulletin-stats{grid-template-columns:1fr;} }
  </style>
</BaseLayout>
