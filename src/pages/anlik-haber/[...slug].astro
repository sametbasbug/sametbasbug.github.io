---
import LegacyNewsRedirect from '../../components/news/LegacyNewsRedirect.astro';
import { getPublishedAnlikHaber } from '../../data/anlikHaber';
import { getNewsArticleHref } from '../../data/newsSite';

export async function getStaticPaths() {
  const entries = await getPublishedAnlikHaber();
  return entries.map((entry) => ({ params: { slug: entry.id } }));
}

const routeSlug = Astro.params.slug ?? '';
const to = getNewsArticleHref(routeSlug);
---

<LegacyNewsRedirect
  to={to}
  title="Bu haber yeni adresine taşındı"
  description="Anlık Haber detay sayfaları artık haber.sametbasbug.dev üzerinde yayında."
/>
