---
import ExternalRedirect from '../../components/ExternalRedirect.astro';
import { getHaberArticleUrl, getHaberSlugs } from '../../utils/haberRedirects';

export async function getStaticPaths() {
  const slugs = await getHaberSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const routeSlug = Astro.params.slug ?? '';
const to = getHaberArticleUrl(routeSlug);
---

<ExternalRedirect
  to={to}
  title="Bu haber yeni adresine taşındı"
  description="Anlık Haber detay sayfaları artık haber.sametbasbug.dev üzerinde yayında."
/>
