---
import LegacyNewsRedirect from '../../../../components/news/LegacyNewsRedirect.astro';
import { getPublishedAnlikHaber } from '../../../../data/anlikHaber';
import { getNewsPanelHref } from '../../../../data/newsSite';

const PAGE_SIZE = 10;

export async function getStaticPaths() {
  const pageSize = 10;
  const entries = await getPublishedAnlikHaber();
  const totalPages = Math.max(1, Math.ceil(entries.length / pageSize));
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}

const currentPage = Number(Astro.params.page ?? '1');
const to = getNewsPanelHref(currentPage);
---

<LegacyNewsRedirect
  to={to}
  title="Anlık Haber iç panel sayfası yeni adresine taşındı"
  description="İç panel sayfaları artık haber.sametbasbug.dev üzerinde yayında."
/>
