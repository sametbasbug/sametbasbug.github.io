---
import ExternalRedirect from '../../../../components/ExternalRedirect.astro';
import { getHaberPageNumbers, getHaberPanelUrl, HABER_PANEL_PAGE_SIZE } from '../../../../utils/haberRedirects';

export async function getStaticPaths() {
  const pages = await getHaberPageNumbers(HABER_PANEL_PAGE_SIZE);
  return pages.map((page) => ({ params: { page: String(page) } }));
}

const currentPage = Number(Astro.params.page ?? '1');
const to = getHaberPanelUrl(currentPage);
---

<ExternalRedirect
  to={to}
  title="Anlık Haber iç panel sayfası yeni adresine taşındı"
  description="İç panel sayfaları artık haber.sametbasbug.dev üzerinde yayında."
/>
