---
import LegacyNewsRedirect from '../../../components/news/LegacyNewsRedirect.astro';
import { ANLIK_HABER_PAGE_SIZE, getPublishedAnlikHaber } from '../../../data/anlikHaber';
import { getNewsPageHref } from '../../../data/newsSite';

export async function getStaticPaths({ paginate }) {
  const entries = await getPublishedAnlikHaber();
  return paginate(entries, { pageSize: ANLIK_HABER_PAGE_SIZE }).filter((page) => page.params.page !== '1');
}

const currentPage = Number(Astro.params.page ?? '1');
const to = getNewsPageHref(currentPage);
---

<LegacyNewsRedirect
  to={to}
  title="Anlık Haber arşivi yeni adresine taşındı"
  description="Anlık Haber sayfalama yüzeyi artık haber.sametbasbug.dev üzerinde yayında."
/>
