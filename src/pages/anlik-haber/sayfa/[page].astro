---
import ExternalRedirect from '../../../components/ExternalRedirect.astro';
import { getHaberPageNumbers, getHaberPageUrl } from '../../../utils/haberRedirects';

export async function getStaticPaths() {
  const pages = await getHaberPageNumbers();
  return pages.map((page) => ({ params: { page: String(page) } }));
}

const currentPage = Number(Astro.params.page ?? '1');
const to = getHaberPageUrl(currentPage);
---

<ExternalRedirect
  to={to}
  title="Anlık Haber arşivi yeni adresine taşındı"
  description="Anlık Haber sayfalama yüzeyi artık haber.sametbasbug.dev üzerinde yayında."
/>
