---
import NewsLayout from '../../../layouts/NewsLayout.astro';
import NewsStream from '../../../components/news/NewsStream.astro';
import {
	formatNewsDate,
	findNewsCategoryBySlug,
	getAnlikHaberCategories,
	getNewsCategoryToken,
	getPublishedAnlikHaber,
	normalizeNewsCategory,
	slugifyNewsCategory,
} from '../../../data/anlikHaber';

export async function getStaticPaths() {
	const categories = getAnlikHaberCategories();
	return categories.map((category) => ({
		params: { category: slugifyNewsCategory(category) },
		props: { category },
	}));
}

const slug = Astro.params.category;
const categories = getAnlikHaberCategories();
const selectedCategory = Astro.props.category ?? findNewsCategoryBySlug(categories, slug) ?? 'Tümü';
const allEntries = await getPublishedAnlikHaber();
const entries = allEntries.filter((entry) => normalizeNewsCategory(entry.data.category) === selectedCategory);
const leadEntry = entries[0];
const streamEntries = entries.slice(1);
const categoryToken = getNewsCategoryToken(selectedCategory);

const title = `Anlık Haber | ${selectedCategory}`;
const description = `${selectedCategory} kategorisindeki kısa ve okunaklı haber akışı.`;
---

<NewsLayout
	title={title}
	description={description}
	pageTitle={selectedCategory}
	pageDescription={`${selectedCategory} kategorisindeki gelişmeler, kısa ve temiz bir akışta.`}
	topMeta={`${entries.length} haber`}
	categories={categories}
	activeCategory={selectedCategory}
>
	{leadEntry ? (
		<>
			<a href={`/anlik-haber/${leadEntry.id}/`} class="category-lead-card">
				{leadEntry.data.heroImage && <img src={leadEntry.data.heroImage} alt="" loading="eager" decoding="async" />}
				<div class="category-lead-overlay"></div>
				<div class="category-lead-copy">
					<span class="category-badge" data-category={categoryToken}>{selectedCategory}</span>
					<h2>{leadEntry.data.title}</h2>
					<p>{leadEntry.data.description}</p>
					<div class="category-meta">
						<time datetime={leadEntry.data.pubDate.toISOString()}>{formatNewsDate(leadEntry.data.pubDate)}</time>
						<span>{leadEntry.data.author ?? 'Nyx AI'}</span>
					</div>
				</div>
			</a>

			<section class="category-stream-head">
				<h2>Bu kategorideki diğer haberler</h2>
			</section>

			<NewsStream entries={streamEntries} currentPage={1} totalPages={1} />
		</>
	) : (
		<div class="category-empty-state">
			<h2>Bu kategoride henüz haber yok.</h2>
			<p>İlk kayıt geldiğinde burada ayrı akış oluşacak.</p>
		</div>
	)}
</NewsLayout>

<style>
	.category-lead-card {
		position: relative;
		display: block;
		margin-top: 0.85rem;
		min-height: 270px;
		border-radius: 1rem;
		overflow: hidden;
		text-decoration: none;
		border: 1px solid color-mix(in srgb, var(--news-border) 88%, transparent);
		background: #0b0b0b;
		box-shadow: 0 16px 40px rgba(0,0,0,0.18);
	}
	.category-lead-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		filter: saturate(0.95) brightness(0.82);
	}
	.category-lead-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(0,0,0,0.08) 0%, rgba(0,0,0,0.3) 36%, rgba(0,0,0,0.9) 100%);
	}
	.category-lead-copy {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 1;
		padding: 1rem 1.05rem;
	}
	.category-badge {
		display: inline-flex;
		padding: 0.22rem 0.48rem;
		border-radius: 999px;
		background: rgba(255,255,255,0.12);
		border: 1px solid rgba(255,255,255,0.1);
		color: #fff;
		font-size: 0.64rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.category-badge[data-category='siyaset'] {
		background: rgba(249, 115, 96, 0.16);
		border-color: rgba(249, 115, 96, 0.28);
		color: #fff2ef;
	}
	.category-badge[data-category='ekonomi'] {
		background: rgba(242, 185, 75, 0.18);
		border-color: rgba(242, 185, 75, 0.28);
		color: #fff8ea;
	}
	.category-badge[data-category='turkiye'] {
		background: rgba(251, 113, 133, 0.18);
		border-color: rgba(251, 113, 133, 0.28);
		color: #fff1f4;
	}
	.category-badge[data-category='dunya'] {
		background: rgba(96, 165, 250, 0.18);
		border-color: rgba(96, 165, 250, 0.28);
		color: #eef6ff;
	}
	.category-badge[data-category='teknoloji'] {
		background: rgba(52, 211, 153, 0.18);
		border-color: rgba(52, 211, 153, 0.28);
		color: #ecfff8;
	}
	.category-lead-copy h2 {
		margin: 0.45rem 0 0;
		font-size: clamp(1.45rem, 2.6vw, 2.15rem);
		line-height: 0.98;
		letter-spacing: -0.04em;
		color: #fff;
		max-width: 12ch;
	}
	.category-lead-copy p {
		margin-top: 0.55rem;
		max-width: 48ch;
		color: rgba(255,255,255,0.8);
		font-size: 0.9rem;
		line-height: 1.55;
	}
	.category-meta {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-top: 0.55rem;
		color: rgba(255,255,255,0.7);
		font-size: 0.74rem;
	}
	.category-stream-head {
		padding: 1.25rem 0 0.6rem;
		border-bottom: 1px solid color-mix(in srgb, var(--news-border) 82%, transparent);
		margin-top: 1rem;
	}
	.category-stream-head h2 {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 850;
		letter-spacing: -0.03em;
	}
	.category-empty-state {
		padding: 1rem 0;
	}
	.category-empty-state h2 {
		font-size: 1.4rem;
		margin-bottom: 0.35rem;
	}
	.category-empty-state p {
		color: var(--news-muted-strong);
	}
</style>
