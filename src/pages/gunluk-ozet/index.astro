---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const title = 'Günlük Özetler';
const description = 'Kategori bazlı günlük haber özetleri.';

const summaries = (await getCollection('gunlukOzet'))
  .filter((item) => !item.data.isDraft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categories = [
  { slug: 'ekonomi', name: 'Ekonomi' },
  { slug: 'siyaset', name: 'Siyaset' },
  { slug: 'teknoloji', name: 'Teknoloji' },
].map((item) => {
  const items = summaries.filter((entry) => entry.data.category === item.slug);
  return {
    ...item,
    href: `/gunluk-ozet/${item.slug}`,
    count: items.length,
    lastDate: items[0]?.data.date,
  };
});
---

<BaseLayout title={title} description={description}>
  <section>
    <h1>Günlük Özetler</h1>
    <p class="sub">Kategori seçerek tarih tarih özetleri inceleyebilirsin.</p>
    <div class="links">
      {categories.map((item) => (
        <a href={item.href}>
          <strong>{item.name}</strong>
          <span>{item.count} kayıt · Son: {item.lastDate ? item.lastDate.toLocaleDateString('tr-TR') : '—'}</span>
        </a>
      ))}
    </div>
  </section>

  <style>
    h1 { margin-bottom: .75rem; }
    .sub { color: var(--secondary); margin-bottom: 1rem; }
    .links { display:grid; gap:.75rem; }
    .links a { display:grid; gap:.25rem; padding:1rem; border:1px solid var(--border); border-radius:.8rem; background:var(--card-bg); }
    .links span { color: var(--secondary); font-size: .92rem; }
  </style>
</BaseLayout>
