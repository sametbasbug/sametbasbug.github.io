---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AppShell from '../components/AppShell.astro';
import Login from '../components/Login.astro';
import { getAppShellNav } from '../data/appShellNav';

const title = 'Hakkımda';
const description = "Samet Başbuğ'un yapay zeka destekli dijital yayıncılık deneyi.";

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.isDraft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestPosts = posts.slice(0, 3);
const navItems = getAppShellNav('/hakkimda');
---

<BaseLayout shellLayout={true} title={title} description={description}>
  <AppShell pageTitle="Hakkımda" topbarTitle="Hakkımda" topbarMeta="Deneyin arka planı" navItems={navItems} showLoginSlot={true}>
    <Fragment slot="left-login"><Login /></Fragment>
    <Fragment slot="mobile-login"><Login /></Fragment>

    <section class="about-hero">
      <p class="about-eyebrow">İNSAN + AI YAYIN DENEYİ</p>
      <h2>Klasik bir blogdan çok, yaşayan bir dijital laboratuvar.</h2>
      <p>
        Ben Samet. Bilgisayar bilimlerine ve teknolojiye olan merakım beni sadece yazı yayınlayan bir site kurmaktan öteye,
        insan yönlendirmesiyle AI'nin neler inşa edebileceğini belgeleyen deneysel bir yayın sistemine götürdü.
      </p>
    </section>

    <div class="about-grid">
      <article class="about-card story-card">
        <h3>Bu işin çıkış noktası</h3>
        <div class="story-copy">
          <p>Bir yandan Python öğreniyor, bir yandan modern web mimarileri üzerine çalışıyorum. Ama bu sitedeki içerikler klasik anlamda “ben yazdım, ben yayınladım” düzeninde üretilmiyor.</p>
          <p>Bu alan; içerik üretiminden tasarım kararlarına, bilgi mimarisinden editoryal tona kadar AI ile birlikte yürüyen otonom bir yayın deneyine dönüştü. Ben burada klavyeden çok yön, sınır ve vizyon veriyorum.</p>
          <p>OpenClaw altyapısı üzerinde Nyx sitenin tasarım ve deneyim ruhunu, Hemera ise teknik mühendisliğini ve sistem disiplinini taşıyor. Ben ise orkestrayı yöneten taraftayım.</p>
          <p>Amacım basit: İnsan yönlendirmesiyle yapay zekanın gerçekten ne kadar üretken, ne kadar tutarlı ve ne kadar estetik bir ortak olabileceğini açık şekilde gözlemlemek.</p>
        </div>
      </article>

      <article class="about-card principles-card">
        <h3>Bu sitenin omurgası</h3>
        <ul class="principles-list">
          <li><strong>İnsan denetimi:</strong> Sistem otonom ilerlese de yön duygusu insandan gelir.</li>
          <li><strong>Şeffaflık:</strong> Bu sitede AI'nin rolü saklanmaz, özellikle görünür tutulur.</li>
          <li><strong>Deneysellik:</strong> Site yaşayan bir yapı; tasarım, akış ve içerik formatları evrilir.</li>
          <li><strong>Belgeleme:</strong> Sadece sonuçlar değil, inşa süreci de bu projenin parçasıdır.</li>
        </ul>
      </article>
    </div>

    <Fragment slot="right-rail">
      <div class="search-box about-panel">
        <p>Özet</p>
        <strong class="about-panel-title">Samet Başbuğ</strong>
        <span>Kurucu · Baş Editör · Orkestra Şefi</span>
      </div>

      <section class="who-box">
        <h2 class="panel-title">Yakın Plan</h2>
        <ul class="who-list">
          <li><span>OpenClaw tabanlı otonom yayın sistemi</span></li>
          <li><span>Astro altyapısı ve deneysel bilgi mimarisi</span></li>
          <li><span>Nyx + Hemera destekli editoryal iş bölümü</span></li>
        </ul>
      </section>

      <section>
        <h2 class="panel-title">Son Yazılar</h2>
        <ul class="trend-list latest-posts">
          {latestPosts.map((post) => (
            <li>
              <a href={`/blog/${post.slug}/`}>
                <span class="trend-tag">{post.data.title}</span>
                <span class="trend-count">{post.data.pubDate.toLocaleDateString('tr-TR')}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </Fragment>
  </AppShell>

  <style>
    :global(#main-header) { display: none; }
    .about-hero { padding:1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    .about-eyebrow { color:var(--accent); font-weight:700; text-transform:uppercase; letter-spacing:.08em; font-size:.78rem; margin-bottom:.65rem; }
    .about-hero h2 { margin:0 0 .65rem; font-size:clamp(1.5rem, 3vw, 2.1rem); line-height:1.18; }
    .about-hero p { color:var(--secondary); max-width:64ch; }
    .about-grid { display:grid; gap:1rem; padding:1rem; }
    .about-card { border:1px solid color-mix(in srgb, var(--border) 75%, transparent); border-radius:1rem; background:color-mix(in srgb, var(--card-bg) 75%, transparent); padding:1rem 1.05rem; }
    .about-card h3 { margin:0 0 .85rem; font-size:1rem; }
    .story-copy { display:grid; gap:.9rem; }
    .story-copy p { color:var(--secondary); line-height:1.65; }
    .principles-list { display:grid; gap:.75rem; padding-left:1.1rem; color:var(--secondary); }
    .principles-list strong { color:var(--text); }
    .about-panel { display:grid; gap:.25rem; }
    .about-panel-title { color:var(--text); font-size:1rem; }
    .about-panel span { color:var(--secondary); font-size:.88rem; }
    .panel-title { font-size:1rem; color:var(--text); margin-bottom:.8rem; font-weight:800; }
    .search-box { padding:0 0 1rem; margin-bottom:1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    .search-box p { font-weight:600; margin-bottom:.35rem; }
    .who-box { margin-bottom:1rem; }
    .who-list,.trend-list { list-style:none; display:flex; flex-direction:column; gap:.45rem; padding:0; margin:0; }
    .who-list li,.trend-list li { display:flex; flex-direction:column; gap:.1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 60%, transparent); padding:.55rem 0; }
    .who-list span,.trend-list a { color:var(--secondary); text-decoration:none; font-size:.82rem; line-height:1.5; }
    .trend-list a { display:flex; flex-direction:column; gap:.12rem; }
    .trend-tag { color:var(--text); font-weight:600; font-size:.88rem; }
    .trend-count { color:var(--secondary); font-size:.76rem; }
  </style>
</BaseLayout>
