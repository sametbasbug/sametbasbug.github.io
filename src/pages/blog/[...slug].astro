---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppShell from '../../components/AppShell.astro';
import Login from '../../components/Login.astro';
import CommentSection from '../../components/CommentSection.astro';
import LikeButton from '../../components/LikeButton.astro';
import { findAuthorByName } from '../../data/authors';
import { getAppShellNav } from '../../data/appShellNav';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => !post.data.isDraft)
    .map((post) => ({
      params: { slug: post.id },
    }));
}
type Props = CollectionEntry<'blog'>;

const routeSlug = Astro.params.slug;
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.isDraft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const post = posts.find((item) => item.id === routeSlug) as Props | undefined;

if (!post) {
  throw new Error(`Blog post not found for id: ${routeSlug}`);
}

const { Content } = await render(post);

const currentIndex = posts.findIndex((p) => p.id === post.id);
const nextPost = posts[currentIndex - 1];
const prevPost = posts[currentIndex + 1];
const authorProfile = findAuthorByName(post.data.author);
const relatedByTag = posts
  .filter((item) => item.id !== post.id)
  .filter((item) => (item.data.tags ?? []).some((tag) => (post.data.tags ?? []).includes(tag)))
  .slice(0, 3);

const navItems = getAppShellNav();
---

<BaseLayout shellLayout={true} title={post.data.title} description={post.data.description}>
  <AppShell pageTitle="İçerik" topbarTitle="İçerik" topbarMeta={post.data.pubDate.toLocaleDateString('tr-TR')} navItems={navItems} showLoginSlot={true} shellClass="app-shell-wide app-shell-reading">
    <Fragment slot="left-login"><Login /></Fragment>
    <Fragment slot="mobile-login"><Login /></Fragment>
    <article class="post-article" aria-label={`${post.data.title} yazı sayfası`}>
      <div class="post-topbar">
        <a href="/" class="back-link">← Ana sayfaya dön</a>
        <div class="topbar-links">
          <a href="/bulten">Bülten</a>
        </div>
      </div>

      <div class="post-header">
        <div class="meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('tr-TR', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          {post.data.author && (
            <span class="author">
              Yazar:{' '}
              {authorProfile ? (
                <a href={`/yazar/${authorProfile.slug}/`}><strong>{post.data.author}</strong></a>
              ) : (
                <strong>{post.data.author}</strong>
              )}
            </span>
          )}
          {post.data.tags && (
            <div class="post-tags">
              {post.data.tags.map((tag) => (
                <a href={`/?tag=${encodeURIComponent(tag.toLocaleLowerCase('tr-TR'))}`} class="tag">#{tag}</a>
              ))}
            </div>
          )}
        </div>
        <h1>{post.data.title}</h1>
        <p class="post-lead">{post.data.description}</p>
        {post.data.heroImage && (
          <div class="hero-image">
            <img width={1020} height={510} src={post.data.heroImage} alt="" />
          </div>
        )}
      </div>

      <div class="prose">
        <Content />
      </div>

      <LikeButton postId={post.id} postTitle={post.data.title} postSlug={`/blog/${post.id}/`} />
      <CommentSection postId={post.id} />

      <div class="share-section">
        <span class="share-label">İçeriği Paylaş</span>
        <div class="share-buttons">
          <a href={`https://twitter.com/intent/tweet?text=${post.data.title}&url=${Astro.url}`} target="_blank" rel="noopener noreferrer" class="share-btn twitter" title="X (Twitter)'da Paylaş">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="share-icon"><path d="M4 4l11.733 16h4.267l-11.733 -16z" /><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" /></svg>
          </a>
          <a href={`https://api.whatsapp.com/send?text=${post.data.title}%20${Astro.url}`} target="_blank" rel="noopener noreferrer" class="share-btn whatsapp" title="WhatsApp'ta Paylaş">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="share-icon"><path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" /><path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" /></svg>
          </a>
          <button class="share-btn copy-link" id="copy-share-link" title="Bağlantıyı Kopyala">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="share-icon"><path d="M10 14a3.5 3.5 0 0 0 5 0l4 -4a3.5 3.5 0 0 0 -5 -5l-.5 .5" /><path d="M14 10a3.5 3.5 0 0 0 -5 0l-4 4a3.5 3.5 0 0 0 5 5l.5 -.5" /></svg>
          </button>
        </div>
      </div>

      <nav class="post-nav">
        {prevPost ? (
          <a href={`/blog/${prevPost.id}/`} class="nav-card prev">
            <span class="nav-label">← Önceki Yazı</span>
            <span class="nav-title">{prevPost.data.title}</span>
          </a>
        ) : <div />}

        {nextPost ? (
          <a href={`/blog/${nextPost.id}/`} class="nav-card next">
            <span class="nav-label">Sonraki Yazı →</span>
            <span class="nav-title">{nextPost.data.title}</span>
          </a>
        ) : <div />}
      </nav>
    </article>

    <Fragment slot="right-rail">
      <div class="search-box author-panel">
        <p>Bu içerik hakkında</p>
        <strong class="author-panel-title">{post.data.title}</strong>
        <span>{post.data.description}</span>
        <div class="post-meta-grid">
          <div><strong>Tarih</strong><span>{post.data.pubDate.toLocaleDateString('tr-TR')}</span></div>
          <div><strong>Yazar</strong><span>{post.data.author ?? 'Samet BaÅŸbuÄŸ'}</span></div>
        </div>
      </div>

      {post.data.tags && post.data.tags.length > 0 && (
        <section class="who-box">
          <h2 class="panel-title">Etiketler</h2>
          <div class="side-tags">
            {post.data.tags.map((tag) => (
              <a href={`/?tag=${encodeURIComponent(tag.toLocaleLowerCase('tr-TR'))}`}>#{tag}</a>
            ))}
          </div>
        </section>
      )}

      {relatedByTag.length > 0 && (
        <section>
          <h2 class="panel-title">Benzer İçerikler</h2>
          <div class="related-list">
            {relatedByTag.map((item) => (
              <a href={`/blog/${item.id}/`}>
                <strong>{item.data.title}</strong>
                <span>{item.data.pubDate.toLocaleDateString('tr-TR')}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </Fragment>
  </AppShell>

  <style>
    :global(#main-header) { display: none; }
    .post-article { padding: 1.5rem 1.75rem; min-width: 0; }
    .post-topbar { display:flex; justify-content:space-between; gap:1rem; align-items:center; color:var(--secondary); font-size:.92rem; padding-bottom:.9rem; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    .back-link,.topbar-links a { color:var(--accent); text-decoration:none; font-weight:600; }
    .topbar-links { display:flex; gap:1rem; flex-wrap:wrap; justify-content:flex-end; margin-left:auto; }
    .post-header { margin:1rem 0 2rem; text-align:center; }
    .meta { color:var(--secondary); margin-bottom:1rem; font-size:.875rem; font-weight:500; display:flex; flex-direction:column; align-items:center; gap:.75rem; }
    .author { font-size:.9rem; color:var(--text); }
    .author a { text-decoration:none; }
    .author strong { color:var(--accent); }
    .post-tags { display:flex; gap:.5rem; justify-content:center; flex-wrap:wrap; }
    .tag { display:inline-flex; background:var(--accent-light); color:var(--accent); font-size:.75rem; font-weight:600; padding:.2rem .6rem; border-radius:2rem; text-decoration:none; border:1px solid color-mix(in srgb, var(--accent) 22%, transparent); }
    .post-article h1 { font-size:clamp(2rem, 4.6vw, 3.4rem); margin-bottom:1rem; font-weight:800; line-height:1.08; text-wrap: balance; }
    .post-lead { max-width:50rem; margin:0 auto; color:var(--secondary); font-size:1.05rem; line-height:1.65; }
    .hero-image { width:100%; margin:2rem 0; border-radius:1rem; overflow:hidden; }
    img { width:100%; height:auto; display:block; border-radius:1rem; box-shadow:0 10px 15px -3px rgba(0,0,0,.1); }
    .prose { font-size:1.125rem; color:var(--text); line-height:1.8; }
    .prose :global(h2) { font-size:2rem; margin-top:3rem; margin-bottom:1.5rem; font-weight:700; }
    .prose :global(h3) { font-size:1.5rem; margin-top:2rem; font-weight:700; }
    .prose :global(p) { margin-bottom:1.5rem; }
    .prose :global(blockquote) { border-left:4px solid var(--accent); background:var(--muted); padding:1.5rem 2rem; border-radius:0 1rem 1rem 0; font-style:italic; color:var(--secondary); margin:2rem 0; }
    .prose :global(code) { background:var(--muted); padding:.2rem .4rem; border-radius:.3rem; font-size:.875em; border:1px solid var(--border); }
    .prose :global(pre) { padding:1.5rem; border-radius:1rem; margin:2rem 0; box-shadow:inset 0 2px 4px 0 rgb(0 0 0 / .05); }
    .post-nav { display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-top:3rem; padding-top:1.5rem; border-top:1px solid var(--border); }
    .nav-card { display:flex; flex-direction:column; padding:1.2rem; border-radius:1rem; border:1px solid var(--border); background:var(--muted); transition:all .3s ease; text-decoration:none !important; }
    .nav-card:hover { border-color:var(--accent); background:var(--card-bg); transform:translateY(-3px); box-shadow:var(--shadow); }
    .nav-label { font-size:.8rem; font-weight:600; color:var(--secondary); margin-bottom:.5rem; text-transform:uppercase; letter-spacing:.05em; }
    .nav-title { font-size:1.02rem; font-weight:700; color:var(--text); line-height:1.4; }
    .next { text-align:right; }
    .share-section { margin-top:3rem; text-align:center; padding:1.5rem; background:var(--muted); border-radius:1.2rem; border:1px solid var(--border); }
    .share-label { display:block; font-size:.8rem; font-weight:700; color:var(--secondary); text-transform:uppercase; letter-spacing:.1em; margin-bottom:1rem; }
    .share-buttons { display:flex; justify-content:center; gap:1rem; flex-wrap:wrap; }
    .share-btn { width:3rem; height:3rem; border-radius:1rem; display:flex; align-items:center; justify-content:center; background:var(--card-bg); border:1px solid var(--border); color:var(--text); text-decoration:none !important; transition:all .3s cubic-bezier(0.4,0,0.2,1); cursor:pointer; }
    .share-btn:hover { transform:translateY(-5px); border-color:var(--accent); color:var(--accent); box-shadow:var(--shadow); }
    .share-icon { width:1.5rem; height:1.5rem; display:block; }
    .author-panel { display:grid; gap:.25rem; padding:0 0 1rem; margin-bottom:1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    .author-panel-title { color:var(--text); font-size:1rem; }
    .author-panel span { color:var(--secondary); font-size:.88rem; line-height:1.55; }
    .post-meta-grid { display:grid; gap:.65rem; margin-top:.75rem; }
    .post-meta-grid div { border:1px solid color-mix(in srgb, var(--border) 72%, transparent); border-radius:.85rem; padding:.7rem .8rem; background:color-mix(in srgb, var(--card-bg) 78%, transparent); }
    .post-meta-grid strong { display:block; color:var(--text); font-size:.8rem; margin-bottom:.15rem; }
    .post-meta-grid span { font-size:.82rem; }
    .panel-title { font-size:1rem; color:var(--text); margin-bottom:.8rem; font-weight:800; }
    .who-box { margin-bottom:1rem; }
    .side-tags,.related-list { display:grid; gap:.55rem; }
    .side-tags a { text-decoration:none; color:var(--accent); background:var(--accent-light); border-radius:999px; padding:.32rem .68rem; width:fit-content; border:1px solid color-mix(in srgb, var(--accent) 22%, transparent); font-size:.82rem; }
    .related-list a { text-decoration:none; display:grid; gap:.18rem; padding:.55rem 0; border-bottom:1px solid color-mix(in srgb, var(--border) 60%, transparent); }
    .related-list strong { color:var(--text); font-size:.92rem; }
    .related-list span { color:var(--secondary); font-size:.78rem; }
    @media (max-width: 820px) { .post-topbar{flex-direction:row;align-items:center;justify-content:space-between;} .topbar-links{justify-content:flex-end;margin-left:auto;} .post-article{padding:.85rem;} .post-nav{grid-template-columns:1fr;} }
  </style>
</BaseLayout>

