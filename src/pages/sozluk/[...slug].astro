---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppShell from '../../components/AppShell.astro';
import Login from '../../components/Login.astro';
import { getAppShellNav } from '../../data/appShellNav';

export async function getStaticPaths() {
  const entries = await getCollection('sozluk');
  return entries
    .filter((entry) => !entry.data.isDraft)
    .map((entry) => ({
      params: { slug: entry.id },
    }));
}

type Props = CollectionEntry<'sozluk'>;

const routeSlug = Astro.params.slug;
const entries = (await getCollection('sozluk'))
  .filter((entry) => !entry.data.isDraft)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'tr'));

const entry = entries.find((item) => item.id === routeSlug) as Props | undefined;

if (!entry) {
  throw new Error(`Sözlük maddesi bulunamadı: ${routeSlug}`);
}

const { Content } = await render(entry);

const categoryMeta = {
  'teknik-terimler': 'Temel Teknik Terimler',
  'komutlar-ve-araclar': 'Komutlar ve Araçlar',
  'ai-ve-otomasyon': 'AI ve Otomasyon',
} as const;

const relatedEntries = (entry.data.related ?? [])
  .map((slug) => entries.find((item) => item.id === slug))
  .filter(Boolean) as CollectionEntry<'sozluk'>[];

const confusedEntries = (entry.data.confusedWith ?? []).map((item) => ({
  ...item,
  entry: entries.find((candidate) => candidate.id === item.slug),
}));

const navItems = getAppShellNav('/sozluk');
---

<BaseLayout shellLayout={true} title={entry.data.title} description={entry.data.description}>
  <AppShell pageTitle="Sözlük" topbarTitle="Sözlük Maddesi" topbarMeta={categoryMeta[entry.data.category]} navItems={navItems} showLoginSlot={true} shellClass="app-shell-wide app-shell-reading glossary-entry-shell-merged">
    <Fragment slot="left-login"><Login /></Fragment>
    <Fragment slot="mobile-login"><Login /></Fragment>

    <article class="entry-article" aria-label={`${entry.data.title} sözlük maddesi`}>
      <div class="entry-topbar">
        <a href="/sozluk" class="back-link">← Sözlüğe dön</a>
      </div>

      <div class="entry-header">
        <span class="entry-category">{categoryMeta[entry.data.category]}</span>
        <h1>{entry.data.title}</h1>
        <p class="entry-lead">{entry.data.description}</p>

        {entry.data.aliases && entry.data.aliases.length > 0 && (
          <div class="alias-list">
            {entry.data.aliases.map((alias) => (
              <span>{alias}</span>
            ))}
          </div>
        )}
      </div>

      <section class="entry-utility-grid">
        <div class="utility-card utility-card-summary">
          <span class="utility-label">Hızlı bakış</span>
          <strong>{entry.data.summary}</strong>
          <p>Bu maddeyi kısa ve net hatırlamak istersen başlangıç noktası burası.</p>
        </div>

        {entry.data.example && (
          <div class="utility-card utility-card-example">
            <span class="utility-label">Mini örnek</span>
            <strong>{entry.data.example.title ?? `${entry.data.title} nasıl görünür?`}</strong>
            <p>{entry.data.example.body}</p>
          </div>
        )}
      </section>

      {confusedEntries.length > 0 && (
        <section class="confused-section">
          <h2>Sık karıştırılanlar</h2>
          <div class="confused-grid">
            {confusedEntries.map((item) => (
              <a href={`/sozluk/${item.slug}/`} class="confused-card">
                <strong>{item.title}</strong>
                <span>{item.note}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <div class="prose">
        <Content />
      </div>

      {relatedEntries.length > 0 && (
        <section class="related-section">
          <h2>İlgili maddeler</h2>
          <div class="related-grid">
            {relatedEntries.map((item) => (
              <a href={`/sozluk/${item.id}/`} class="related-card">
                <strong>{item.data.title}</strong>
                <span>{item.data.summary}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>

  </AppShell>

  <style>
    :global(#main-header) { display: none; }
    :global(.glossary-entry-shell-merged.app-shell) { grid-template-columns:240px minmax(0, 960px); }
    :global(.glossary-entry-shell-merged > .right-rail) { display:none; }
    :global(.glossary-entry-shell-merged > .center-feed) { border-right:0; }
    .entry-article { padding:1.5rem 1.75rem; min-width:0; }
    .entry-topbar { display:flex; justify-content:space-between; gap:1rem; align-items:center; color:var(--secondary); font-size:.92rem; padding-bottom:.9rem; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    .back-link { color:var(--accent); text-decoration:none; font-weight:600; }
    .entry-header { margin:1rem 0 2rem; text-align:center; }
    .entry-category { display:inline-flex; background:var(--accent-light); color:var(--accent); font-size:.75rem; font-weight:700; padding:.28rem .7rem; border-radius:999px; border:1px solid color-mix(in srgb, var(--accent) 22%, transparent); margin-bottom:1rem; text-transform:uppercase; letter-spacing:.05em; }
    .entry-article h1 { font-size:clamp(2rem, 4.6vw, 3.2rem); margin-bottom:1rem; font-weight:800; line-height:1.18; text-wrap:balance; }
    .entry-lead { max-width:52rem; margin:0 auto; color:var(--secondary); font-size:1.05rem; line-height:1.65; }
    .alias-list { display:flex; gap:.45rem; justify-content:center; flex-wrap:wrap; margin-top:1rem; }
    .alias-list span { display:inline-flex; background:color-mix(in srgb, var(--card-bg) 82%, transparent); color:var(--secondary); font-size:.8rem; font-weight:600; padding:.28rem .65rem; border-radius:999px; border:1px solid color-mix(in srgb, var(--border) 75%, transparent); }
    .entry-utility-grid { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:.85rem; margin:0 0 1.5rem; }
    .utility-card { display:grid; gap:.35rem; padding:1rem 1.05rem; border-radius:1rem; border:1px solid color-mix(in srgb, var(--border) 78%, transparent); background:linear-gradient(180deg, color-mix(in srgb, var(--card-bg) 90%, transparent), color-mix(in srgb, var(--muted) 38%, transparent)); }
    .utility-label { color:var(--accent); font-size:.74rem; font-weight:800; text-transform:uppercase; letter-spacing:.07em; }
    .utility-card strong { color:var(--text); font-size:1rem; line-height:1.4; }
    .utility-card p { color:var(--secondary); font-size:.9rem; line-height:1.6; }
    .confused-section { margin:0 0 1.8rem; }
    .confused-section h2 { margin-bottom:.9rem; font-size:1.08rem; }
    .confused-grid { display:grid; gap:.75rem; }
    .confused-card { display:grid; gap:.18rem; padding:1rem; border-radius:1rem; border:1px solid color-mix(in srgb, var(--border) 76%, transparent); background:color-mix(in srgb, var(--card-bg) 84%, transparent); text-decoration:none; }
    .confused-card strong { color:var(--text); font-size:.96rem; }
    .confused-card span { color:var(--secondary); font-size:.88rem; line-height:1.55; }
    .prose { font-size:1.05rem; color:var(--text); line-height:1.8; }
    .prose :global(h2) { font-size:1.7rem; margin-top:2.6rem; margin-bottom:1rem; font-weight:800; }
    .prose :global(h3) { font-size:1.2rem; margin-top:1.6rem; margin-bottom:.7rem; font-weight:700; }
    .prose :global(p) { margin-bottom:1rem; }
    .prose :global(ul) { margin:0 0 1.2rem 1.2rem; }
    .prose :global(li) { margin-bottom:.55rem; }
    .prose :global(code) { background:var(--muted); padding:.2rem .4rem; border-radius:.3rem; font-size:.875em; border:1px solid var(--border); }
    .prose :global(pre) { padding:1.5rem; border-radius:1rem; margin:2rem 0; box-shadow:inset 0 2px 4px 0 rgb(0 0 0 / .05); }
    .related-section { margin-top:2.5rem; padding-top:1.5rem; border-top:1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    .related-section h2 { margin-bottom:1rem; font-size:1.1rem; }
    .related-grid { display:grid; gap:.75rem; }
    .related-card { display:grid; gap:.2rem; padding:1rem; border-radius:1rem; border:1px solid var(--border); background:color-mix(in srgb, var(--card-bg) 82%, transparent); text-decoration:none; }
    .related-card strong { color:var(--text); font-size:.95rem; }
    .related-card span { color:var(--secondary); font-size:.87rem; line-height:1.5; }
    @media (max-width: 820px) {
      .entry-article{padding:.9rem;}
      .entry-utility-grid { grid-template-columns:1fr; }
    }
  </style>
</BaseLayout>
