---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppShell from '../../components/AppShell.astro';
import Login from '../../components/Login.astro';
import { getAppShellNav } from '../../data/appShellNav';

const title = 'Sözlük';
const description = 'Teknik terimler, komutlar ve otomasyon kavramları için sade ama derli toplu bir referans alanı.';

const entries = (await getCollection('sozluk'))
  .filter((entry) => !entry.data.isDraft)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'tr'));

const categoryMeta = {
  'teknik-terimler': {
    title: 'Temel Teknik Terimler',
    description: 'Web, yazılım ve altyapı dünyasında sık geçen kavramların sade açıklamaları.',
  },
  'komutlar-ve-araclar': {
    title: 'Komutlar ve Araçlar',
    description: 'Komut satırında gördüğün ifadelerin ne yaptığı ve ne zaman kullanıldığı.',
  },
  'ai-ve-otomasyon': {
    title: 'AI ve Otomasyon',
    description: 'Ajanlar, görev akışları ve otomatik çalışan sistemler için temel sözlük alanı.',
  },
} as const;

const groupedEntries = Object.entries(categoryMeta).map(([slug, meta]) => ({
  slug,
  ...meta,
  entries: entries.filter((entry) => entry.data.category === slug),
}));

const navItems = getAppShellNav('/sozluk');
---

<BaseLayout shellLayout={true} title={title} description={description}>
  <AppShell pageTitle="Sözlük" topbarTitle="Sözlük" topbarMeta={`${entries.length} terim`} navItems={navItems} showLoginSlot={true} shellClass="glossary-shell-merged">
    <Fragment slot="left-login"><Login /></Fragment>
    <Fragment slot="mobile-login"><Login /></Fragment>

    <div slot="mobile-hub">
      <label class="mobile-search" aria-label="Sözlükte ara">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4a6 6 0 1 1 0 12 6 6 0 0 1 0-12Zm0-2a8 8 0 1 0 4.9 14.3l5.4 5.4 1.4-1.4-5.4-5.4A8 8 0 0 0 10 2Z"/></svg>
        <input id="glossary-search-mobile" type="search" placeholder="Terim veya komut ara" />
      </label>
      <div class="mobile-search-status" id="glossary-search-status-mobile" aria-hidden="true">
        <strong id="glossary-search-count-mobile">0 sonuç</strong>
        <button type="button" id="glossary-search-clear-mobile">Temizle</button>
      </div>
    </div>

    <section class="glossary-hero">
      <div class="glossary-hero-copy">
        <h2>Teknik terimleri ve komutları insan diliyle toparladık.</h2>
        <p>Buradaki amaç gösteriş değil, netlik. Bir kavramla karşılaştığında kısa tanımı gör, detayına gir, ilgili başlıklara ak.</p>
      </div>

      <div class="glossary-hero-stats" aria-label="Sözlük özeti">
        <div class="glossary-hero-badge">
          <span class="hero-badge-value">{groupedEntries.length}</span>
          <span class="hero-badge-label">kategori</span>
        </div>
        <div class="glossary-hero-badge">
          <span class="hero-badge-value">{entries.length}</span>
          <span class="hero-badge-label">canlı madde</span>
        </div>
      </div>
    </section>

    <section class="glossary-toolbar" aria-label="Sözlük araçları">
      <div class="glossary-search-card">
        <p class="toolbar-label">Ara</p>
        <input id="glossary-search-input" type="search" placeholder="API, cron, npm run build..." />
        <span>Aradığını başlık, açıklama veya eş anlam üzerinden bulabilirsin.</span>
        <div class="search-status" id="glossary-search-status" aria-hidden="true">
          <strong id="glossary-search-count">0 sonuç</strong>
          <button type="button" id="glossary-search-clear">Aramayı temizle</button>
        </div>
      </div>

      <div class="glossary-notes-card">
        <p class="toolbar-label">Başlangıç rotası</p>
        <ul class="toolbar-list">
          <li>Temel mantık için teknik terimlerden başla.</li>
          <li>Komutlarda önce ne yaptığını, sonra riskini oku.</li>
          <li>Otomasyon başlıkları sistemin nasıl hareket ettiğini açıklar.</li>
        </ul>
      </div>
    </section>

    <section class="glossary-jump" aria-labelledby="glossary-jump-title">
      <div class="jump-head">
        <h3 id="glossary-jump-title">Kategoriden gir</h3>
        <p>Direkt istediğin bölüme atla. Uzun liste içinde kaybolma.</p>
      </div>

      <div class="jump-grid">
        {groupedEntries.map((group) => (
          <a href={`#group-${group.slug}`} class="jump-card">
            <span>{group.entries.length} madde</span>
            <strong>{group.title}</strong>
            <p>{group.description}</p>
          </a>
        ))}
      </div>
    </section>

    <div class="glossary-sections">
      {groupedEntries.map((group) => (
        <section class="glossary-group" aria-labelledby={`group-${group.slug}`}>
          <div class="group-head">
            <h3 id={`group-${group.slug}`}>{group.title}</h3>
            <p>{group.description}</p>
          </div>

          <div class="glossary-grid">
            {group.entries.map((entry) => (
              <a
                href={`/sozluk/${entry.id}/`}
                class="glossary-card"
                data-glossary-item
                data-search={[entry.data.title, entry.data.description, entry.data.summary, ...(entry.data.aliases ?? [])].join(' ').toLocaleLowerCase('tr-TR')}
              >
                <span class="glossary-category" data-highlight-source>{group.title}</span>
                <strong data-highlight-source>{entry.data.title}</strong>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

  </AppShell>

  <script>
    function initGlossarySearch() {
      const desktopInput = document.getElementById('glossary-search-input');
      const mobileInput = document.getElementById('glossary-search-mobile');
      const searchStatus = document.getElementById('glossary-search-status');
      const searchCount = document.getElementById('glossary-search-count');
      const clearButton = document.getElementById('glossary-search-clear');
      const mobileSearchStatus = document.getElementById('glossary-search-status-mobile');
      const mobileSearchCount = document.getElementById('glossary-search-count-mobile');
      const mobileClearButton = document.getElementById('glossary-search-clear-mobile');
      const shell = document.querySelector('.glossary-shell-merged');
      const groups = Array.from(document.querySelectorAll('.glossary-group'));
      const items = Array.from(document.querySelectorAll('[data-glossary-item]'));
      const highlightTargets = Array.from(document.querySelectorAll('[data-highlight-source]'));
      if ((!desktopInput && !mobileInput) || items.length === 0) return;

      highlightTargets.forEach((el) => {
        if (!el.dataset.originalText) {
          el.dataset.originalText = el.textContent || '';
        }
      });

      const syncInputs = (value) => {
        if (desktopInput && desktopInput.value !== value) desktopInput.value = value;
        if (mobileInput && mobileInput.value !== value) mobileInput.value = value;
      };

      const escapeRegExp = (value) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

      const applyHighlight = (raw) => {
        const query = (raw || '').trim();
        if (!query) {
          highlightTargets.forEach((el) => {
            el.textContent = el.dataset.originalText || '';
          });
          return;
        }

        const safeQuery = escapeRegExp(query);
        const regex = new RegExp(`(${safeQuery})`, 'giu');

        highlightTargets.forEach((el) => {
          const source = el.dataset.originalText || '';
          el.innerHTML = source.replace(regex, '<mark class="glossary-hit">$1</mark>');
        });
      };

      const applyFilter = (raw) => {
        const query = (raw || '').toLocaleLowerCase('tr-TR').trim();
        let visibleCount = 0;

        items.forEach((item) => {
          const haystack = (item.getAttribute('data-search') || '').toLocaleLowerCase('tr-TR');
          const isVisible = !query || haystack.includes(query);
          item.style.display = isVisible ? '' : 'none';
          if (isVisible) visibleCount += 1;
        });

        groups.forEach((group) => {
          const visibleItems = group.querySelectorAll('[data-glossary-item]:not([style*="display: none"])').length;
          const head = group.querySelector('.group-head');
          group.style.display = visibleItems > 0 ? '' : 'none';
          if (head) head.style.display = query ? (visibleItems > 0 ? '' : 'none') : '';
        });

        const searchActive = query.length > 0;
        document.body.classList.toggle('glossary-search-active', searchActive);
        shell?.classList.toggle('glossary-search-active', searchActive);

        applyHighlight(raw);

        if (searchStatus && searchCount) {
          searchStatus.classList.toggle('is-active', searchActive);
          searchStatus.setAttribute('aria-hidden', searchActive ? 'false' : 'true');
          searchCount.textContent = `${visibleCount} sonuç${searchActive ? ` · “${raw.trim()}”` : ''}`;
        }

        if (mobileSearchStatus && mobileSearchCount) {
          mobileSearchStatus.classList.toggle('is-active', searchActive);
          mobileSearchStatus.setAttribute('aria-hidden', searchActive ? 'false' : 'true');
          mobileSearchCount.textContent = `${visibleCount} sonuç`;
        }
      };

      const bind = (input, twin) => {
        if (!input || input.dataset.bound === '1') return;
        input.dataset.bound = '1';
        input.addEventListener('input', () => {
          if (twin && twin.value !== input.value) twin.value = input.value;
          applyFilter(input.value);
        });
      };

      const clearSearch = (focusTarget = desktopInput || mobileInput) => {
        syncInputs('');
        applyFilter('');
        focusTarget?.focus();
      };

      if (clearButton && clearButton.dataset.bound !== '1') {
        clearButton.dataset.bound = '1';
        clearButton.addEventListener('click', () => {
          clearSearch(desktopInput || mobileInput);
        });
      }

      if (mobileClearButton && mobileClearButton.dataset.bound !== '1') {
        mobileClearButton.dataset.bound = '1';
        mobileClearButton.addEventListener('click', () => {
          clearSearch(mobileInput || desktopInput);
        });
      }

      bind(desktopInput, mobileInput);
      bind(mobileInput, desktopInput);
      applyFilter(desktopInput?.value || mobileInput?.value || '');
    }

    initGlossarySearch();
    document.addEventListener('astro:page-load', initGlossarySearch);
  </script>

  <style>
    :global(#main-header) { display: none; }
    :global(.glossary-shell-merged.app-shell) { grid-template-columns:240px minmax(0, 960px); }
    :global(.glossary-shell-merged > .right-rail) { display:none; }
    :global(.glossary-shell-merged > .center-feed) { border-right:0; }
    .glossary-hero {
      display:grid;
      grid-template-columns:minmax(0, 1fr) auto;
      gap:1rem;
      align-items:end;
      padding:1.25rem 1rem;
      border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent);
      background:
        radial-gradient(circle at top left, color-mix(in srgb, var(--accent) 18%, transparent), transparent 38%),
        linear-gradient(180deg, color-mix(in srgb, var(--card-bg) 92%, transparent), transparent);
    }
    .glossary-hero-copy {
      display:grid;
      gap:.2rem;
      min-width:0;
    }
    .glossary-hero h2 { margin:0 0 .45rem; font-size:clamp(1.7rem, 3.5vw, 2.7rem); line-height:1.08; max-width:13ch; letter-spacing:-.02em; }
    .glossary-hero p { color:var(--secondary); max-width:64ch; }
    .glossary-hero-stats {
      display:grid;
      gap:.6rem;
      align-self:end;
    }
    .glossary-hero-badge {
      display:grid;
      gap:.2rem;
      min-width:148px;
      padding:1rem 1.05rem;
      border-radius:1.15rem;
      border:1px solid color-mix(in srgb, var(--accent) 28%, var(--border));
      background:linear-gradient(180deg, color-mix(in srgb, var(--accent) 16%, var(--card-bg)), color-mix(in srgb, var(--card-bg) 92%, transparent));
      box-shadow:0 16px 36px -24px color-mix(in srgb, var(--accent) 40%, transparent);
    }
    .hero-badge-value { color:var(--text); font-size:2rem; font-weight:800; line-height:1; }
    .hero-badge-label { color:var(--secondary); font-size:.86rem; }
    .glossary-summary { padding:1rem; color:var(--secondary); border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); background:color-mix(in srgb, var(--card-bg) 65%, transparent); }
    .glossary-summary strong { color:var(--text); }
    .glossary-toolbar { display:grid; grid-template-columns:minmax(0, 1.2fr) minmax(0, .8fr); gap:.85rem; padding:1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    .glossary-search-card,.glossary-notes-card {
      display:grid;
      gap:.55rem;
      padding:1rem;
      border-radius:1rem;
      border:1px solid color-mix(in srgb, var(--border) 80%, transparent);
      background:linear-gradient(180deg, color-mix(in srgb, var(--card-bg) 90%, transparent), color-mix(in srgb, var(--muted) 42%, transparent));
      box-shadow:0 10px 25px -22px rgba(0,0,0,.45);
      transition:transform .24s ease, box-shadow .24s ease, border-color .24s ease, padding .24s ease;
    }
    .toolbar-label { color:var(--accent); font-size:.78rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em; }
    .glossary-search-card input { width:100%; border:1px solid color-mix(in srgb, var(--border) 70%, transparent); background:color-mix(in srgb, white 6%, transparent); color:var(--text); padding:.8rem .95rem; border-radius:999px; transition:border-color .18s ease, box-shadow .18s ease, background .18s ease; }
    .glossary-search-card input:focus { outline:none; border-color:color-mix(in srgb, var(--accent) 60%, white); box-shadow:0 0 0 4px color-mix(in srgb, var(--accent) 15%, transparent); }
    .glossary-search-card span,.glossary-notes-card li { color:var(--secondary); font-size:.88rem; line-height:1.55; }
    .search-status {
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:.75rem;
      max-height:0;
      opacity:0;
      overflow:hidden;
      padding:0 .85rem;
      border-top:1px solid transparent;
      margin-top:0;
      transform:translateY(-6px);
      pointer-events:none;
      transition:max-height .24s ease, opacity .2s ease, transform .24s ease, padding .24s ease, margin-top .24s ease, border-color .24s ease;
    }
    .search-status.is-active {
      max-height:4rem;
      opacity:1;
      padding:.75rem .85rem 0;
      border-top:1px solid color-mix(in srgb, var(--border) 55%, transparent);
      margin-top:.2rem;
      transform:translateY(0);
      pointer-events:auto;
    }
    .search-status strong { color:var(--text); font-size:.9rem; }
    .search-status button { border:1px solid color-mix(in srgb, var(--border) 70%, transparent); background:transparent; color:var(--secondary); border-radius:999px; padding:.4rem .75rem; font:inherit; font-size:.82rem; cursor:pointer; }
    .search-status button:hover { color:var(--text); border-color:var(--accent); }
    .toolbar-list { margin:0; padding-left:1rem; display:grid; gap:.35rem; }
    .glossary-jump { display:grid; gap:1rem; padding:1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    .jump-head h3 { margin:0 0 .3rem; font-size:1.1rem; }
    .jump-head p { color:var(--secondary); }
    .jump-grid { display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:.75rem; }
    .jump-card {
      position:relative;
      overflow:hidden;
      display:grid;
      gap:.35rem;
      padding:1rem;
      border-radius:1.05rem;
      border:1px solid color-mix(in srgb, var(--border) 80%, transparent);
      background:linear-gradient(180deg, color-mix(in srgb, var(--card-bg) 90%, transparent), color-mix(in srgb, var(--muted) 52%, transparent));
      text-decoration:none;
      transition:transform .18s ease, border-color .18s ease, background .18s ease, box-shadow .18s ease;
      box-shadow:0 12px 30px -26px rgba(0,0,0,.55);
    }
    .jump-card:hover { transform:translateY(-3px); border-color:var(--accent); background:color-mix(in srgb, var(--muted) 68%, transparent); box-shadow:0 18px 35px -24px color-mix(in srgb, var(--accent) 28%, transparent); }
    .jump-card span { color:var(--accent); font-size:.78rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em; }
    .jump-card strong { color:var(--text); font-size:1rem; }
    .jump-card p { color:var(--secondary); font-size:.88rem; line-height:1.5; }
    .glossary-sections { display:grid; gap:1.25rem; padding:1rem; }
    .glossary-group { display:grid; gap:.85rem; scroll-margin-top:1rem; }
    .group-head {
      display:grid;
      gap:.25rem;
      padding:.15rem 0 .45rem;
      border-bottom:1px solid color-mix(in srgb, var(--border) 45%, transparent);
    }
    .group-head h3 { margin:0; font-size:1.28rem; letter-spacing:-.02em; }
    .group-head p { color:var(--secondary); max-width:70ch; }
    .glossary-grid { display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:.75rem; }
    .glossary-card {
      position:relative;
      display:grid;
      gap:.28rem;
      border:1px solid color-mix(in srgb, var(--border) 80%, transparent);
      background:linear-gradient(180deg, color-mix(in srgb, var(--card-bg) 92%, transparent), color-mix(in srgb, var(--muted) 42%, transparent));
      padding:1rem 1.05rem;
      border-radius:1rem;
      text-decoration:none;
      transition:transform .18s ease, border-color .18s ease, background .18s ease, box-shadow .18s ease;
      min-width:0;
      box-shadow:0 10px 25px -24px rgba(0,0,0,.55);
      min-height:108px;
      align-content:center;
    }
    .glossary-card:hover {
      transform:translateY(-3px);
      border-color:color-mix(in srgb, var(--accent) 72%, white);
      background:linear-gradient(180deg, color-mix(in srgb, var(--muted) 74%, transparent), color-mix(in srgb, var(--card-bg) 88%, transparent));
      box-shadow:0 16px 32px -22px color-mix(in srgb, var(--accent) 24%, transparent);
    }
    .glossary-card strong { color:var(--text); font-size:1.03rem; line-height:1.3; }
    .glossary-category { color:var(--accent); font-size:.72rem; font-weight:800; text-transform:uppercase; letter-spacing:.07em; }
    .glossary-hit {
      background:color-mix(in srgb, #facc15 52%, transparent);
      color:inherit;
      border-radius:.25rem;
      padding:0 .12rem;
      box-shadow:0 0 0 1px color-mix(in srgb, #facc15 22%, transparent);
    }
    .mobile-search { display:flex; align-items:center; gap:.45rem; border:1px solid color-mix(in srgb, var(--border) 70%, transparent); background:color-mix(in srgb, white 6%, transparent); color:var(--secondary); border-radius:999px; padding:.48rem .75rem; margin-bottom:.45rem; }
    .mobile-search svg { width:14px; height:14px; fill:currentColor; flex-shrink:0; }
    .mobile-search input { width:100%; border:0; background:transparent; color:var(--secondary); font-size:.88rem; outline:none; }
    .mobile-search-status {
      display:none;
      align-items:center;
      justify-content:space-between;
      gap:.6rem;
      color:var(--secondary);
      font-size:.8rem;
      padding:0 .1rem;
    }
    .mobile-search-status.is-active { display:flex; }
    .mobile-search-status strong { color:var(--text); font-size:.84rem; }
    .mobile-search-status button {
      border:1px solid color-mix(in srgb, var(--border) 70%, transparent);
      background:transparent;
      color:var(--secondary);
      border-radius:999px;
      padding:.28rem .62rem;
      font:inherit;
      font-size:.78rem;
      cursor:pointer;
    }
    :global(body.glossary-search-active) .glossary-hero,
    :global(body.glossary-search-active) .glossary-notes-card,
    :global(body.glossary-search-active) .glossary-jump { display:none; }
    :global(body.glossary-search-active) .glossary-toolbar { grid-template-columns:1fr; }
    :global(body.glossary-search-active) .glossary-search-card {
      position:sticky;
      top:.75rem;
      z-index:6;
      padding:1.08rem 1rem 1rem;
      transform:translateY(-2px) scale(1.01);
      box-shadow:0 18px 36px -24px color-mix(in srgb, var(--accent) 22%, transparent);
      border-color:color-mix(in srgb, var(--accent) 24%, var(--border));
    }
    :global(body.glossary-search-active) .glossary-sections {
      display:grid;
      grid-template-columns:repeat(4, minmax(0, 1fr));
      gap:.75rem;
      padding-top:.5rem;
      align-items:start;
    }
    :global(body.glossary-search-active) .glossary-group { display:contents !important; }
    :global(body.glossary-search-active) .group-head { display:none !important; }
    :global(body.glossary-search-active) .glossary-grid { display:contents; }
    :global(body.glossary-search-active) .glossary-card { height:100%; }
    @media (max-width: 1380px) {
      .glossary-grid,
      :global(body.glossary-search-active) .glossary-sections { grid-template-columns:repeat(3, minmax(0, 1fr)); }
    }
    @media (max-width: 1120px) {
      .glossary-grid,
      :global(body.glossary-search-active) .glossary-sections { grid-template-columns:repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 980px) {
      .glossary-hero { grid-template-columns:1fr; align-items:start; }
      .glossary-hero h2 { max-width:none; }
      .glossary-hero-stats {
        grid-template-columns:repeat(2, minmax(0, 1fr));
        width:100%;
        align-self:stretch;
      }
      .glossary-hero-badge { min-width:0; width:100%; }
      .glossary-toolbar { grid-template-columns:1fr; }
      .glossary-search-card { display:none !important; }
      .jump-grid { grid-template-columns:1fr; }
      .glossary-grid { grid-template-columns:repeat(2, minmax(0, 1fr)); }
      :global(body.glossary-search-active) .glossary-sections { grid-template-columns:repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 390px) {
      .glossary-grid { grid-template-columns:1fr; }
      :global(body.glossary-search-active) .glossary-sections { grid-template-columns:1fr; }
    }
  </style>
</BaseLayout>
