---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import { getGlossary, glossaryByCategory } from "../../lib/glossary";

const terms = await getGlossary();
const groups = glossaryByCategory(terms);
---

<Base
  title="Sözlük"
  description="Yapay zekâ, web ve altyapı terimlerinin Türkçe karşılıkları — kısa, örnekli ve birbirine bağlı."
>
  <PageHead
    eyebrow={`${terms.length} terim`}
    title="Sözlük"
    lead="Yazılarda geçen terimlerin karşılıkları. Kısa tanım, bir örnek ve ne zaman önemli olduğu."
  >
    <div class="rise mt-10 max-w-md" style="--rise-delay:520ms">
      <label class="relative block">
        <span class="sr-only">Sözlükte ara</span>
        <input
          id="term-search"
          type="search"
          placeholder="Terim veya tanım…"
          autocomplete="off"
          class="w-full rounded-full border border-line bg-surface-raised/50 px-5 py-3 pl-11 text-sm text-ink outline-none transition-colors placeholder:text-ink-faint focus:border-ember"
        />
        <svg
          viewBox="0 0 24 24"
          class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-faint"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        >
          <circle cx="11" cy="11" r="6.5"></circle>
          <path stroke-linecap="round" d="m16 16 4.5 4.5"></path>
        </svg>
      </label>
    </div>
  </PageHead>

  <section class="px-5 pb-24 sm:px-8">
    <div class="mx-auto max-w-[88rem]">
      {
        groups.map(([category, items]) => (
          <div class="term-group mb-14">
            <div class="reveal sticky top-[4.5rem] z-10 -mx-2 flex items-baseline gap-4 bg-surface/70 px-2 py-3 backdrop-blur-md">
              <h2 class="text-display text-2xl text-ink-faint">{category}</h2>
              <span class="h-px flex-1 bg-line/70" />
              <span class="label">{items.length}</span>
            </div>

            <ul class="mt-6 grid gap-px overflow-hidden rounded-2xl border border-line/70 bg-line/50 sm:grid-cols-2 lg:grid-cols-3">
              {items.map((entry, index) => (
                <li
                  class="term reveal bg-surface"
                  style={`--reveal-delay:${Math.min(index, 8) * 40}ms`}
                  data-search={`${entry.data.term} ${entry.data.summary}`.toLocaleLowerCase("tr")}
                >
                  <a
                    href={`/sozluk/${entry.id}/`}
                    class="group flex h-full flex-col gap-2 p-5 transition-colors duration-500 hover:bg-surface-raised"
                  >
                    <span class="text-display text-xl transition-colors duration-300 group-hover:text-ember">
                      {entry.data.term}
                    </span>
                    <span class="text-sm leading-relaxed text-ink-soft">{entry.data.summary}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <p id="term-empty" class="hidden py-20 text-center text-ink-soft">
        Bu aramaya uyan terim yok. <span class="text-ember">Başka bir kelime dene.</span>
      </p>
    </div>
  </section>
</Base>

<style>
  .term.is-hidden {
    display: none;
  }
</style>

<script>
  const setupGlossary = () => {
    const input = document.getElementById("term-search") as HTMLInputElement | null;
    if (!input || input.dataset.bound) return;
    input.dataset.bound = "1";

    const terms = [...document.querySelectorAll<HTMLElement>(".term")];
    const groups = [...document.querySelectorAll<HTMLElement>(".term-group")];
    const empty = document.getElementById("term-empty");

    input.addEventListener("input", () => {
      const query = input.value.trim().toLocaleLowerCase("tr");
      let visible = 0;

      for (const term of terms) {
        const match = !query || (term.dataset.search ?? "").includes(query);
        term.classList.toggle("is-hidden", !match);
        if (match) visible++;
      }

      for (const group of groups) {
        group.classList.toggle("hidden", !group.querySelector(".term:not(.is-hidden)"));
      }

      empty?.classList.toggle("hidden", visible > 0);
    });
  };

  setupGlossary();
  document.addEventListener("astro:page-load", setupGlossary);
</script>
