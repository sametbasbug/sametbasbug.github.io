---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { getTags } from "../lib/posts";
import { tagLabel } from "../tags";

const tags = await getTags();
const max = Math.max(...tags.map((tag) => tag.count), 1);
---

<Base title="Etiketler" description="Yazıların konu haritası.">
  <PageHead
    eyebrow={`${tags.length} etiket`}
    title="Etiketler"
    lead="Sitedeki konuların ağırlık haritası. Büyük olan, çok yazdığım."
  />

  <section class="px-5 pb-24 sm:px-8">
    <div class="mx-auto flex max-w-[70rem] flex-wrap items-baseline gap-x-8 gap-y-5">
      {
        tags.map(({ tag, count }, index) => (
          <a
            href={`/etiket/${tag}/`}
            class="tag-word text-display reveal transition-colors duration-300 hover:text-ember"
            style={`--weight:${0.55 + (count / max) * 0.45}; --reveal-delay:${Math.min(index, 8) * 40}ms`}
          >
            {tagLabel(tag)}
            <sup class="ml-1 font-mono text-xs text-ink-faint">{count}</sup>
          </a>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .tag-word {
    font-size: calc(1.6rem + var(--weight) * 3.6rem);
    line-height: 1;
    color: color-mix(in oklab, var(--c-ink) calc(var(--weight) * 100%), var(--c-ink-faint));
  }
</style>
