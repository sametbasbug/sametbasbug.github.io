---
import type { CollectionEntry } from "astro:content";
import { authors, formatDate, readingTime } from "../site";
import Sigil from "./Sigil.astro";
import { tagLabel } from "../tags";

interface Props {
  post: CollectionEntry<"posts">;
  index?: number;
  size?: "sm" | "md";
  /** "row" — sigil solda, metin sağda; geniş yerleşimler için. */
  layout?: "stack" | "row";
  class?: string;
}

const {
  post,
  index = 0,
  size = "md",
  layout = "stack",
  class: className = "",
} = Astro.props;

const author = authors[post.data.author];
const minutes = readingTime(post.body ?? "");
const isRow = layout === "row";
---

<article
  class:list={["tilt reveal group relative", className]}
  style={`--reveal-delay:${Math.min(index, 6) * 55}ms`}
>
  <a href={`/yazi/${post.id}/`} class="block focus:outline-none">
    <div
      class:list={[
        "tilt__inner relative overflow-hidden rounded-2xl border border-line/70 bg-surface-raised/40 backdrop-blur-sm transition-colors duration-500 group-hover:border-ember/60",
        isRow && "sm:grid sm:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] sm:items-stretch",
      ]}
    >
      <!-- imleç ışığı -->
      <div class="card-glow"></div>

      <div
        class:list={[
          "relative overflow-hidden border-line/60",
          isRow ? "aspect-[16/10] border-b sm:aspect-auto sm:border-b-0 sm:border-r" : "aspect-[16/10] border-b",
        ]}
      >
        <!-- Yazı sayfasındaki kapak ile aynı ada sahip: geçişte biri
             diğerine dönüşüyor. Kapak verilmediyse sigil. -->
        <div class="absolute inset-0" transition:name={`sigil-${post.id}`}>
          {
            post.data.cover ? (
              <img
                src={post.data.cover}
                alt={post.data.coverAlt ?? ""}
                loading="lazy"
                decoding="async"
                class="sigil absolute inset-0 h-full w-full object-cover"
              />
            ) : (
              <Sigil seed={post.data.title} class="sigil absolute inset-0 h-full w-full" />
            )
          }
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-surface/70 via-transparent to-transparent"></div>
        <span class="label absolute left-4 top-4 text-[0.6rem] text-ink-soft">
          {formatDate(post.data.date)}
        </span>
      </div>

      <div
        class:list={[
          "relative flex flex-col p-5 sm:p-6",
          isRow && "sm:justify-center sm:p-8 lg:p-10",
        ]}
      >
        <h3
          class:list={[
            "text-display leading-[1.05] transition-colors duration-300 group-hover:text-ember",
            isRow
              ? "text-2xl sm:text-[clamp(1.7rem,2.6vw,2.6rem)]"
              : size === "sm"
                ? "text-xl sm:text-2xl"
                : "text-2xl sm:text-[1.7rem]",
          ]}
        >
          {post.data.title}
        </h3>

        <p
          class:list={[
            "mt-3 text-sm leading-relaxed text-ink-soft",
            isRow ? "max-w-prose sm:text-base" : "line-clamp-3",
          ]}
        >
          {post.data.summary}
        </p>

        <div class="mt-5 flex items-center gap-3 text-xs text-ink-faint">
          <span class="text-ember" aria-hidden="true">{author.glyph}</span>
          <span>{author.name}</span>
          <span class="h-px flex-1 bg-line"></span>
          <span class="font-mono">{minutes} dk</span>
        </div>
      </div>
    </div>
  </a>

  {
    post.data.tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {post.data.tags.slice(0, 3).map((tag) => (
          <a
            href={`/etiket/${tag}/`}
            class="label rounded-full border border-line/70 px-2.5 py-1 text-[0.6rem] transition-colors hover:border-ember hover:text-ember"
          >
            {tagLabel(tag)}
          </a>
        ))}
      </div>
    )
  }
</article>

<style>
  .tilt {
    perspective: 900px;
  }

  .tilt__inner {
    transform-style: preserve-3d;
    transition:
      transform 0.5s var(--ease-out-expo),
      box-shadow 0.5s var(--ease-out-expo),
      border-color 0.4s ease;
    will-change: transform;
  }

  .tilt:hover .tilt__inner {
    box-shadow: 0 24px 60px -28px color-mix(in oklab, var(--c-ember) 45%, transparent);
  }

  .sigil {
    transition:
      transform 0.9s var(--ease-out-expo),
      opacity 0.6s ease;
    opacity: 0.85;
    transform: scale(1.02);
  }

  .tilt:hover .sigil {
    transform: scale(1.12) rotate(6deg);
    opacity: 1;
  }

  .card-glow {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s ease;
    background: radial-gradient(
      14rem 14rem at var(--mx, 50%) var(--my, 50%),
      color-mix(in oklab, var(--c-ember) 13%, transparent),
      transparent 70%
    );
  }

  @media (hover: hover) and (pointer: fine) {
    .tilt:hover .card-glow {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tilt__inner,
    .sigil {
      transition: none;
      transform: none !important;
    }
  }
</style>

<script>
  const bindTilt = () => {
    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    document.querySelectorAll<HTMLElement>(".tilt").forEach((card) => {
      if (card.dataset.tilt) return;
      card.dataset.tilt = "1";

      const inner = card.querySelector<HTMLElement>(".tilt__inner");
      const glow = card.querySelector<HTMLElement>(".card-glow");
      if (!inner) return;

      let frame = 0;

      card.addEventListener(
        "pointermove",
        (event) => {
          if (frame) return;
          frame = requestAnimationFrame(() => {
            frame = 0;
            const rect = card.getBoundingClientRect();
            const px = (event.clientX - rect.left) / rect.width;
            const py = (event.clientY - rect.top) / rect.height;
            // Geniş kartlarda aynı açı abartılı duruyor; eğimi küçültüyoruz.
            const tilt = rect.width > 620 ? 3.4 : 7;
            inner.style.transform = `rotateY(${(px - 0.5) * tilt}deg) rotateX(${(0.5 - py) * tilt}deg) translateZ(0)`;
            glow?.style.setProperty("--mx", `${px * 100}%`);
            glow?.style.setProperty("--my", `${py * 100}%`);
          });
        },
        { passive: true },
      );

      card.addEventListener("pointerleave", () => {
        inner.style.transform = "";
      });
    });
  };

  bindTilt();
  document.addEventListener("astro:page-load", bindTilt);
</script>
