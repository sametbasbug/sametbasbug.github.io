<div class="auth-widget" data-auth-widget aria-live="polite">
  <button class="auth-btn auth-btn-login" data-auth-login type="button">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path fill="#EA4335" d="M12 10.2v3.9h5.5c-.2 1.2-1.4 3.6-5.5 3.6-3.3 0-6-2.7-6-6s2.7-6 6-6c1.9 0 3.2.8 4 1.5l2.7-2.6C17 3 14.8 2 12 2 6.5 2 2 6.5 2 12s4.5 10 10 10c5.8 0 9.7-4.1 9.7-9.8 0-.7-.1-1.2-.2-1.8H12z"/>
    </svg>
    <span>Google ile Giriş Yap</span>
  </button>

  <div class="user-profile" data-auth-user hidden>
    <div class="user-meta">
      <img class="user-avatar" data-auth-avatar alt="Profil fotoğrafı" hidden />
      <span class="user-name-text" data-auth-name></span>
    </div>
    <a class="auth-profile-link" href="/profil">Profilim</a>
    <button class="auth-btn auth-btn-logout" data-auth-logout type="button">Çıkış Yap</button>
  </div>
</div>

<script>
  import { signInWithPopup, GoogleAuthProvider, signOut, onAuthStateChanged } from "firebase/auth";
  import { auth } from "../firebase.js";

  const provider = new GoogleAuthProvider();
  const listeners = new WeakMap();

  const renderAuthState = ({ loginBtn, userInfo, userName, userAvatar }, user) => {
    if (!loginBtn || !userInfo || !userName || !userAvatar) return;

    if (user) {
      const firstName = (user.displayName || "Kullanıcı").trim().split(/\s+/)[0] || "Kullanıcı";
      loginBtn.hidden = true;
      loginBtn.style.display = "none";
      userInfo.hidden = false;
      userInfo.style.display = "flex";
      userName.textContent = `Merhaba, ${firstName}`;

      if (user.photoURL) {
        userAvatar.src = user.photoURL;
        userAvatar.hidden = false;
      } else {
        userAvatar.hidden = true;
        userAvatar.removeAttribute("src");
      }
    } else {
      loginBtn.hidden = false;
      loginBtn.style.display = "inline-flex";
      userInfo.hidden = true;
      userInfo.style.display = "none";
      userName.textContent = "";
      userAvatar.hidden = true;
      userAvatar.removeAttribute("src");
    }
  };

  const initAuthWidget = (root) => {
    if (!root) return;

    const loginBtn = root.querySelector("[data-auth-login]");
    const logoutBtn = root.querySelector("[data-auth-logout]");
    const userInfo = root.querySelector("[data-auth-user]");
    const userName = root.querySelector("[data-auth-name]");
    const userAvatar = root.querySelector("[data-auth-avatar]");

    if (!loginBtn || !logoutBtn || !userInfo || !userName || !userAvatar) return;

    if (!root.dataset.eventsBound) {
      root.dataset.eventsBound = "1";

      loginBtn.addEventListener("click", async () => {
        try {
          await signInWithPopup(auth, provider);
        } catch (error) {
          console.error("Giriş hatası:", error);
        }
      });

      logoutBtn.addEventListener("click", async () => {
        try {
          await signOut(auth);
        } catch (error) {
          console.error("Çıkış hatası:", error);
        }
      });
    }

    listeners.get(root)?.();

    const unsub = onAuthStateChanged(auth, (user) => {
      renderAuthState({ loginBtn, userInfo, userName, userAvatar }, user);
    });

    listeners.set(root, unsub);
    renderAuthState({ loginBtn, userInfo, userName, userAvatar }, auth.currentUser);
  };

  const bootAuthWidgets = () => {
    document.querySelectorAll("[data-auth-widget]").forEach(initAuthWidget);
  };

  bootAuthWidgets();
  document.addEventListener("astro:page-load", bootAuthWidgets);
</script>

<style>
  .auth-widget {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.45rem;
    width: 100%;
    min-height: 2.2rem;
  }

  .auth-widget [hidden] {
    display: none !important;
  }

  .auth-btn {
    border: 1px solid var(--border);
    background: var(--card-bg);
    color: var(--text);
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.86rem;
    line-height: 1;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .auth-btn:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    box-shadow: 0 6px 16px rgb(99 102 241 / 0.18);
  }

  .auth-btn-login {
    width: 100%;
    justify-content: center;
    padding: 0.52rem 0.85rem;
    background: linear-gradient(180deg, var(--card-bg), color-mix(in srgb, var(--accent-light) 16%, var(--card-bg)));
  }

  .auth-btn-login svg {
    width: 1rem;
    height: 1rem;
  }

  .user-profile {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.4rem;
    padding: 0.5rem;
    border-radius: 0.9rem;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--muted) 60%, transparent);
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  .user-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 0;
  }

  .user-avatar {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    object-fit: cover;
    border: 1px solid var(--border);
    flex-shrink: 0;
  }

  .user-name-text {
    display: block;
    width: 100%;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: center;
    padding: 0 0.3rem;
  }

  .auth-btn-logout,
  .auth-profile-link {
    width: 100%;
    height: 2.2rem;
    padding: 0 0.72rem;
    border-radius: 999px;
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1;
    box-sizing: border-box;
  }

  .auth-btn-logout {
    justify-content: center;
    background: transparent;
    border-color: color-mix(in srgb, var(--accent) 25%, var(--border));
  }

  .auth-profile-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--accent) 25%, var(--border));
    background: transparent;
    color: var(--text);
    text-decoration: none;
    margin-top: 0.1rem;
    transition: all 0.2s ease;
  }

  .auth-profile-link:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    text-decoration: none;
    transform: translateY(-1px);
  }

  @media (max-width: 700px) {
    .auth-widget {
      width: 100%;
      justify-content: center;
    }
  }
</style>
