---
import { sigil, type Archetype } from "../lib/sigil";

interface Props {
  seed: string;
  class?: string;
  detail?: number;
  /** Çizgi kalınlığı çarpanı; büyük gösterimlerde artır. */
  weight?: number;
  archetype?: Archetype;
}

const {
  seed,
  class: className = "",
  detail = 1,
  weight = 1,
  archetype,
} = Astro.props;

const svg = sigil(seed, { detail, weight, archetype, class: className });
---

<Fragment set:html={svg} />
