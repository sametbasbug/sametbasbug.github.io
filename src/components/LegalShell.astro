---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppShell from './AppShell.astro';
import Login from './Login.astro';
import { getAppShellNav } from '../data/appShellNav';

interface Props {
  title: string;
  description: string;
  activeHref: string;
  updated?: string;
  topbarMeta?: string;
  summary?: string;
}

const {
  title,
  description,
  activeHref,
  updated = '11.03.2026',
  topbarMeta = 'Yasal metin',
  summary = 'Site kullanımına, veri işleme süreçlerine ve topluluk düzenine dair bilgilendirme metni.',
} = Astro.props;

const navItems = getAppShellNav();
const legalLinks = [
  { href: '/gizlilik-politikasi', label: 'Gizlilik Politikası', note: 'Veri işleme ve gizlilik' },
  { href: '/kullanim-sartlari', label: 'Kullanım Şartları', note: 'Hizmet ve hesap kuralları' },
  { href: '/cerez-politikasi', label: 'Çerez Politikası', note: 'Oturum ve teknik çerezler' },
  { href: '/topluluk-kurallari', label: 'Topluluk Kuralları', note: 'Yorum ve etkileşim ilkeleri' },
];
---

<BaseLayout shellLayout={true} title={title} description={description}>
  <AppShell pageTitle={title} topbarTitle={title} topbarMeta={topbarMeta} navItems={navItems} showLoginSlot={true}>
    <Fragment slot="left-login"><Login /></Fragment>
    <Fragment slot="mobile-login"><Login /></Fragment>

    <section class="legal-page" aria-labelledby="legal-title">
      <div class="legal-header">
        <p class="legal-eyebrow">YASAL METİN</p>
        <h2 id="legal-title">{title}</h2>
        <p class="updated">Son güncelleme: {updated}</p>
      </div>
      <div class="legal-body">
        <slot />
      </div>
    </section>

    <Fragment slot="right-rail">
      <div class="search-box legal-panel">
        <p>Bu sayfa</p>
        <strong class="legal-panel-title">{title}</strong>
        <span>{summary}</span>
      </div>

      <section class="legal-links-box">
        <h2 class="panel-title">Yasal Sayfalar</h2>
        <ul class="legal-links-list">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class={link.href === activeHref ? 'active' : undefined}>
                <strong>{link.label}</strong>
                <span>{link.note}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </Fragment>
  </AppShell>

  <style>
    :global(#main-header) { display: none; }
    .legal-page { padding:1.25rem 1.5rem 1.5rem; min-width:0; }
    .legal-header { padding-bottom:1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    .legal-eyebrow { color:var(--accent); font-weight:800; text-transform:uppercase; letter-spacing:.08em; font-size:.78rem; margin-bottom:.65rem; }
    .legal-header h2 { margin:0 0 .65rem; font-size:clamp(1.85rem, 4vw, 2.55rem); line-height:1.15; }
    .updated { color:var(--secondary); font-size:.92rem; }
    .legal-body { padding-top:1.15rem; color:var(--secondary); line-height:1.72; }
    .legal-body :global(p) { color:var(--secondary); margin-bottom:1rem; }
    .legal-body :global(strong) { color:var(--text); }
    .legal-body :global(h3) { color:var(--text); font-size:1.18rem; margin:1.9rem 0 .7rem; line-height:1.35; }
    .legal-body :global(ul) { display:grid; gap:.48rem; padding-left:1.25rem; margin:.4rem 0 1rem; }
    .legal-body :global(li) { color:var(--secondary); }
    .legal-body :global(code) { background:var(--muted); color:var(--text); padding:.1rem .35rem; border-radius:.4rem; border:1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    .legal-body :global(a) { color:var(--accent); text-decoration:none; font-weight:600; }
    .legal-body :global(a:hover) { color:color-mix(in srgb, var(--accent) 82%, white); }
    .legal-panel { display:grid; gap:.25rem; padding:0 0 1rem; margin-bottom:1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    .legal-panel p { font-weight:600; margin-bottom:.15rem; }
    .legal-panel-title { color:var(--text); font-size:1rem; }
    .legal-panel span { color:var(--secondary); font-size:.88rem; line-height:1.55; }
    .panel-title { font-size:1rem; color:var(--text); margin-bottom:.8rem; font-weight:800; }
    .legal-links-box { margin-bottom:1rem; }
    .legal-links-list { list-style:none; display:flex; flex-direction:column; gap:.45rem; padding:0; margin:0; }
    .legal-links-list a { display:flex; flex-direction:column; gap:.1rem; border-bottom:1px solid color-mix(in srgb, var(--border) 60%, transparent); padding:.55rem 0; text-decoration:none; }
    .legal-links-list a strong { color:var(--text); font-size:.9rem; }
    .legal-links-list a span { color:var(--secondary); font-size:.8rem; line-height:1.45; }
    .legal-links-list a:hover strong,
    .legal-links-list a.active strong { color:var(--accent); }
    .legal-links-list a.active span { color:color-mix(in srgb, var(--accent) 70%, var(--secondary)); }
    @media (max-width: 820px) { .legal-page{padding:.95rem;} .legal-header h2{font-size:clamp(1.65rem, 8vw, 2.15rem);} }
  </style>
</BaseLayout>
